{
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jobs": {
    "PollIntervalSeconds": 15,
    "MaximumJobsPerPoll": 50,
    "LeaseDurationSeconds": 120,
    "MaximumAttempts": 3,
    "RetryDelaySeconds": 30
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForJWTTokenGeneration123!@#",
    "Issuer": "BAMS.Server",
    "Audience": "BAMS.Client",
    "ExpiryMinutes": 60
  },
  "FileUploads": {
    "RootPath": "App_Data/AccountDocuments",
    "MaximumFileSizeBytes": 10485760,
    "MaximumRequestSizeBytes": 62914560
  }
}
