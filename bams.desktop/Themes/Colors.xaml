<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="PrimaryColor">#1E40AF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="ForegroundColor">#111827</Color>
    <Color x:Key="MutedForegroundColor">#6B7280</Color>
    <Color x:Key="SecondaryColor">#F3F4F6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"          Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="CardBrush"             Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush"       Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"  Color="{StaticResource MutedForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"        Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="HoverBrush"            Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="AccentForegroundBrush"  Color="White"/>

    <!-- Typography -->
    <FontFamily x:Key="SerifFont">DM Serif Display</FontFamily>
    <FontFamily x:Key="SansFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- Dimensions -->
    <system:Double x:Key="NavBarExpandedWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">220</system:Double>
    <system:Double x:Key="NavBarCollapsedWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">56</system:Double>
    <system:Double x:Key="NavBarHeaderHeight" xmlns:system="clr-namespace:System;assembly=mscorlib">56</system:Double>
</ResourceDictionary>