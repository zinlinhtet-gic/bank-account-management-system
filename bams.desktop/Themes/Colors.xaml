<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Design palette from the "Banking System Components" Figma Make file (src/index.css).
        Use the *Brush keys in XAML. Never hard-code a colour in a view; add a token here instead.
    -->

    <!-- ===== Core palette ===== -->
    <Color x:Key="BackgroundColor">#E8EFF7</Color>          <!-- page background -->
    <Color x:Key="ForegroundColor">#08142A</Color>          <!-- main text -->
    <Color x:Key="CardColor">#FFFFFF</Color>                <!-- cards, inputs, nav, header -->
    <Color x:Key="PrimaryColor">#155D8E</Color>             <!-- main actions, focus, selection -->
    <Color x:Key="PrimaryHoverColor">#124F78</Color>
    <Color x:Key="PrimaryPressedColor">#0F4263</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryColor">#D4E3F2</Color>           <!-- secondary buttons, active nav, selected rows -->
    <Color x:Key="SecondaryHoverColor">#C3D6EA</Color>
    <Color x:Key="SecondaryPressedColor">#B3CAE2</Color>
    <Color x:Key="SecondaryForegroundColor">#0F2A47</Color>
    <Color x:Key="MutedColor">#EEF3FA</Color>               <!-- table header, alternating rows, disabled inputs -->
    <Color x:Key="MutedForegroundColor">#3D5F7C</Color>     <!-- labels, captions, secondary text -->
    <Color x:Key="AccentColor">#956A00</Color>              <!-- gold: highlights, active nav marker, pending -->
    <Color x:Key="AccentHoverColor">#7F5A00</Color>
    <Color x:Key="AccentPressedColor">#6B4C00</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#9BBAD4</Color>
    <Color x:Key="RingColor">#155D8E</Color>                <!-- keyboard focus outline -->
    <Color x:Key="SuccessColor">#0F6642</Color>
    <Color x:Key="DangerColor">#9B2318</Color>
    <Color x:Key="DangerAccentColor">#B3362A</Color>        <!-- danger hover (kept for existing views) -->
    <Color x:Key="DangerPressedColor">#7E1C13</Color>

    <!-- ===== Soft tints (badge / chip backgrounds, focus ring glow) ===== -->
    <Color x:Key="SuccessSoftColor">#1F1E9E6E</Color>       <!-- rgba(30,158,110,.12) -->
    <Color x:Key="WarningSoftColor">#26C49A3C</Color>       <!-- rgba(196,154,60,.15) -->
    <Color x:Key="DangerSoftColor">#1FC44B3C</Color>        <!-- rgba(196,75,60,.12) -->
    <Color x:Key="RingSoftColor">#26155D8E</Color>          <!-- rgba(21,93,142,.15) -->

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="BackgroundBrush"          Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush"          Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="CardBrush"                Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"             Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"   Color="{StaticResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"           Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush"      Color="{StaticResource SecondaryHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush"    Color="{StaticResource SecondaryPressedColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="MutedBrush"               Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"     Color="{StaticResource MutedForegroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush"       Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush"    Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="RingBrush"                Color="{StaticResource RingColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"             Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush"              Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerAccentBrush"        Color="{StaticResource DangerAccentColor}"/>
    <SolidColorBrush x:Key="DangerPressedBrush"       Color="{StaticResource DangerPressedColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush"         Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush"         Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush"          Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="RingSoftBrush"            Color="{StaticResource RingSoftColor}"/>

    <!-- Kept for existing views: hover over list items / nav items. -->
    <SolidColorBrush x:Key="HoverBrush"               Color="{StaticResource MutedColor}"/>

    <!-- ===== Brand panel (login / change-password left side): primary blue fading into deep navy ===== -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource SecondaryForegroundColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandForegroundBrush"      Color="{StaticResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="BrandMutedForegroundBrush" Color="{StaticResource SecondaryHoverColor}"/>
    <SolidColorBrush x:Key="BrandDividerBrush"         Color="#33FFFFFF"/>   <!-- 20% white line on the gradient -->

    <!-- ===== Dialog backdrop: dims the window behind a modal dialog (45% of the foreground navy) ===== -->
    <SolidColorBrush x:Key="OverlayBrush"              Color="#7308142A"/>

    <!-- ===== Shape, spacing, elevation ===== -->
    <CornerRadius x:Key="Radius">3</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">2</CornerRadius>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16</Thickness>
    <system:Double x:Key="ControlHeight">36</system:Double>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#08142A"/>

    <!-- ===== Shell dimensions ===== -->
    <system:Double x:Key="NavBarExpandedWidth">220</system:Double>
    <system:Double x:Key="NavBarCollapsedWidth">56</system:Double>
    <system:Double x:Key="NavBarHeaderHeight">56</system:Double>
    <GridLength x:Key="NavBarHeaderRowHeight">56</GridLength>
</ResourceDictionary>
