<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:bams.desktop.Themes"
                    xmlns:icon="clr-namespace:bams.desktop.Components.Icon">

    <!-- Tokens this file uses. WPF cannot see sibling dictionaries, so each theme file merges its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Typography.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Icons.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Controls/Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Form inputs from the design (TextInput, DropdownList, RadioGroup in App.tsx).
        A field is always: label (Text.FieldLabel) + input + optional hint / error (Text.Hint / Text.Error).

        <StackPanel>
            <TextBlock Text="USERNAME" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.Text}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     t:ThemeAssist.Placeholder="e.g. aung.aung"
                     t:ThemeAssist.HasError="{Binding HasUsernameError}"/>
            <TextBlock Text="{Binding UsernameError}" Style="{StaticResource Text.Error}"/>
        </StackPanel>
    -->

    <!-- ===================== TextBox ===================== -->
    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Soft focus glow (design: box-shadow 0 0 0 2px) -->
                        <Border x:Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="5"
                                BorderBrush="{StaticResource RingSoftBrush}" Visibility="Collapsed"/>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Prefix, e.g. "MMK" -->
                                <Border x:Name="PrefixPart" Background="{StaticResource MutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                                        CornerRadius="2,0,0,2" Padding="12,0">
                                    <TextBlock Text="{TemplateBinding t:ThemeAssist.Prefix}" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <!-- TextBox applies Padding inside the content host itself, so no Margin here. -->
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                              Margin="0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="PlaceholderPart" Grid.Column="1"
                                           Text="{TemplateBinding t:ThemeAssist.Placeholder}"
                                           Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedForegroundBrush}" Opacity="0.75"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="t:ThemeAssist.Prefix" Value="">
                            <Setter TargetName="PrefixPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="t:ThemeAssist.Prefix" Value="{x:Null}">
                            <Setter TargetName="PrefixPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderPart" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter TargetName="PART_ContentHost" Property="Margin" Value="0,6"/>
                            <Setter TargetName="PlaceholderPart" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="PlaceholderPart" Property="Margin" Value="12,8"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="t:ThemeAssist.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Multi-line text: grows with its own Height / MinHeight -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="MinHeight" Value="72"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== PasswordBox ===================== -->
    <!-- PasswordBox cannot show a placeholder (WPF does not expose its text); use a field label instead. -->
    <Style x:Key="Input.Password" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="5"
                                BorderBrush="{StaticResource RingSoftBrush}" Visibility="Collapsed"/>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}">
                            <!-- PasswordBox applies Padding inside the content host itself, so no Margin here. -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="t:ThemeAssist.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox (design: DropdownList) ===================== -->
    <Style x:Key="Input.SelectItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <icon:Icon x:Name="CheckMark" Grid.Column="1" Margin="12,0,0,0"
                                       Geometry="{StaticResource Icon.Check}" Size="14" StrokeThickness="2.5"
                                       Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.Select" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MaxDropDownHeight" Value="240"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Input.SelectItem}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="5"
                                BorderBrush="{StaticResource RingSoftBrush}" Visibility="Collapsed"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource Radius}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock x:Name="PlaceholderPart" Text="{TemplateBinding t:ThemeAssist.Placeholder}"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <icon:Icon x:Name="Chevron" Grid.Column="1" Margin="8,0,0,0"
                                       Geometry="{StaticResource Icon.ChevronDown}" Size="14" StrokeThickness="2"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <!-- Right/bottom margin leaves room for the drop shadow inside the transparent popup. -->
                            <Border Margin="0,0,12,16" Padding="0,4"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}"
                                    Effect="{StaticResource PopupShadow}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="PlaceholderPart" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource MutedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Toggle" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="t:ThemeAssist.HasError" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->
    <Style x:Key="Input.Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="{StaticResource RadiusSmall}"
                                BorderThickness="1.5" BorderBrush="{StaticResource BorderBrush}"
                                Background="{StaticResource CardBrush}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid>
                                <Path x:Name="CheckMark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{StaticResource PrimaryForegroundBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="-1.5" Visibility="Collapsed"/>
                                <Rectangle x:Name="Dash" Width="8" Height="2" Fill="{StaticResource PrimaryForegroundBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="ContentPart" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPart" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RadioButton (design: RadioGroup) ===================== -->
    <!-- For "label + description", put a StackPanel with Text.Title / Text.Caption in the Content. -->
    <Style x:Key="Input.Radio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top">
                            <Ellipse x:Name="Outer" Stroke="{StaticResource BorderBrush}" StrokeThickness="2"
                                     Fill="{StaticResource CardBrush}"/>
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource PrimaryForegroundBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Outer" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== DatePicker ===================== -->
    <!-- Light styling only; the calendar popup keeps the Windows look. -->
    <Style x:Key="Input.Date" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
