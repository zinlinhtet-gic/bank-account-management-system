<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:bams.desktop.Themes"
                    xmlns:icon="clr-namespace:bams.desktop.Components.Icon">

    <!-- Tokens this file uses. WPF cannot see sibling dictionaries, so each theme file merges its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Typography.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Controls/Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        ===================== Tabs =====================
        A tab strip made of RadioButtons that share a GroupName, so exactly one is selected.
        Usage: put them in a StackPanel (Orientation="Horizontal") inside a Border with Style="{StaticResource Tab.Strip}",
        bind IsChecked to the ViewModel, optional icon via t:ThemeAssist.Icon="{StaticResource Icon.Plus}".
        Selected: primary text and a 2px primary underline. Others: muted text, darker on hover.
    -->
    <Style x:Key="Tab.Strip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,4,-1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="t:ThemeAssist.IconSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon x:Name="IconPart"
                                       Geometry="{TemplateBinding t:ThemeAssist.Icon}"
                                       Size="{TemplateBinding t:ThemeAssist.IconSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       StrokeThickness="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="t:ThemeAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
