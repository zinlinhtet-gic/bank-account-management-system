<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:bams.desktop.Themes"
                    xmlns:icon="clr-namespace:bams.desktop.Components.Icon">

    <!-- Tokens this file uses. WPF cannot see sibling dictionaries, so each theme file merges its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Buttons from the design (Button.tsx): Primary, Secondary, Accent, Ghost, Danger.
        Sizes via t:ThemeAssist.Size = Small (28) | Medium (36, default) | Large (44).
        Optional icon via t:ThemeAssist.Icon="{StaticResource Icon.Plus}".
        Spinner via t:ThemeAssist.IsLoading="{Binding IsBusy}".

        <Button Content="New User" Style="{StaticResource Button.Primary}"
                t:ThemeAssist.Size="Small" t:ThemeAssist.Icon="{StaticResource Icon.UserPlus}"
                Command="{Binding CreateUserCommand}"/>
    -->

    <!-- Keyboard focus outline: 2px ring, 2px outside the control (design: focus-visible). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="5"
                            BorderBrush="{StaticResource RingBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared template for every variant. Variants only change colours. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="t:ThemeAssist.IconSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- Loading spinner: faint full circle + rotating quarter arc -->
                            <Grid x:Name="Spinner" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Opacity="0.25"/>
                                <Path x:Name="SpinnerArc" Data="M7,1 A6,6 0 0 1 13,7"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <icon:Icon x:Name="IconPart"
                                       Geometry="{TemplateBinding t:ThemeAssist.Icon}"
                                       Size="{TemplateBinding t:ThemeAssist.IconSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       StrokeThickness="2"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="ContentPart" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="t:ThemeAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Icon-only button: no gap after the icon -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconPart" Property="Margin" Value="0"/>
                            <Setter TargetName="Spinner" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{Binding (t:ThemeAssist.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{Binding (t:ThemeAssist.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Foreground"
                                    Value="{Binding (t:ThemeAssist.HoverForeground), RelativeSource={RelativeSource Self}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{Binding (t:ThemeAssist.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="t:ThemeAssist.IsLoading" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Opacity" Value="0.7"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerArc"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="t:ThemeAssist.Size" Value="Small">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="t:ThemeAssist.IconSize" Value="13"/>
            </Trigger>
            <Trigger Property="t:ThemeAssist.Size" Value="Large">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
                <Setter Property="t:ThemeAssist.IconSize" Value="16"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Main action on a screen (Save, Create, Confirm). Use one per area. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource PrimaryHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource PrimaryPressedBrush}"/>
    </Style>

    <!-- Supporting actions (Search, Apply Filter, Cancel). -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondaryHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource SecondaryHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="{StaticResource SecondaryPressedBrush}"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource SecondaryPressedBrush}"/>
    </Style>

    <!-- Highlighted gold action (Export, Approve). Use sparingly. -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource AccentForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource AccentPressedBrush}"/>
    </Style>

    <!-- Low-emphasis actions (Reset, Alerts, row actions). -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="Transparent"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource SecondaryBrush}"/>
    </Style>

    <!-- Destructive actions (Disable, Delete, Logout). Outlined; fills red on hover. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource DangerPressedBrush}"/>
    </Style>

    <!-- Solid red button: the final "yes, do it" button of a destructive confirmation dialog. -->
    <Style x:Key="Button.DangerSolid" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBackground" Value="{StaticResource DangerPressedBrush}"/>
        <Setter Property="t:ThemeAssist.HoverBorderBrush" Value="{StaticResource DangerPressedBrush}"/>
        <Setter Property="t:ThemeAssist.HoverForeground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="t:ThemeAssist.PressedBackground" Value="{StaticResource DangerPressedBrush}"/>
    </Style>

    <!-- Square icon-only ghost button for table rows and toolbars. Always set a ToolTip. -->
    <!-- Sized with setters (not t:ThemeAssist.Size) so the Small trigger's padding does not squeeze the icon. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="t:ThemeAssist.IconSize" Value="14"/>
        <Setter Property="Content" Value="{x:Null}"/>
    </Style>
</ResourceDictionary>
