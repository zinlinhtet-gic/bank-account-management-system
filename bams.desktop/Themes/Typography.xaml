<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Tokens this file uses. WPF cannot see sibling dictionaries, so each theme file merges its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/bams.desktop;component/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Fonts are bundled in Themes/Fonts (SIL Open Font License), so every PC shows the same UI
        without installing anything. The Windows font after the comma is only a fallback.
    -->
    <FontFamily x:Key="SansFont">pack://application:,,,/bams.desktop;component/Themes/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">pack://application:,,,/bams.desktop;component/Themes/Fonts/#DM Serif Display, Georgia</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/bams.desktop;component/Themes/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <!-- ===== Type scale (from the design's "Typography & Font Sizes" reference) ===== -->
    <system:Double x:Key="FontSizeDisplay">30</system:Double>
    <system:Double x:Key="FontSizeHeading">20</system:Double>
    <system:Double x:Key="FontSizeSubheading">16</system:Double>
    <system:Double x:Key="FontSizeBody">14</system:Double>
    <system:Double x:Key="FontSizeMono">13</system:Double>
    <system:Double x:Key="FontSizeCaption">12</system:Double>
    <system:Double x:Key="FontSizeLabel">11</system:Double>
    <system:Double x:Key="FontSizeTiny">10</system:Double>

    <!-- ===== Text styles. Use these instead of setting FontSize/FontFamily by hand. ===== -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 30 / DM Serif: big page or report titles -->
    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
    </Style>

    <!-- 20 / DM Serif: section headings, dialog titles -->
    <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
    </Style>

    <!-- 16 / DM Serif: card titles ("Component Reference" in the design) -->
    <Style x:Key="Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
    </Style>

    <!-- 16 / Inter 600: sub-headings inside a card -->
    <Style x:Key="Text.Subheading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 14 / Inter 600: table captions ("Recent Transactions") -->
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 14 / Inter 400: normal text -->
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style x:Key="Text.BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
    </Style>

    <!-- 12 / Inter: captions, timestamps, helper text -->
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
    </Style>

    <!-- 12 / Inter 500 muted: form field labels. Write the text in CAPITALS, e.g. "ACCOUNT NAME". -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 11 / Inter 600 muted: small section labels, stat card labels. Write the text in CAPITALS. -->
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
    </Style>

    <!-- 12 under an input: helper text and validation errors -->
    <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style x:Key="Text.Success" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
    </Style>

    <!-- 13 / JetBrains Mono 500: account numbers, amounts, references, codes -->
    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- 24 / JetBrains Mono 600: big numbers on stat cards -->
    <Style x:Key="Text.MonoLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
