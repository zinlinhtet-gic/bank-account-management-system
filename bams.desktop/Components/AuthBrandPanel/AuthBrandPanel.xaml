<UserControl x:Class="bams.desktop.Components.AuthBrandPanel.AuthBrandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon">
    <!-- Left half of the sign-in screens: brand, promise, and three security points. -->
    <Border Background="{StaticResource BrandGradientBrush}">
        <Grid Margin="56,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- logo -->
                <RowDefinition Height="*"/>      <!-- headline + points -->
                <RowDefinition Height="Auto"/>   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Logo: same gold tile as the navigation bar -->
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="{StaticResource Radius}" Background="{StaticResource AccentBrush}">
                    <icon:Icon Geometry="{StaticResource Icon.Bank}" Size="20" StrokeThickness="2.2"
                               Foreground="{StaticResource AccentForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DaLanBank" Style="{StaticResource Text.Heading}" Foreground="{StaticResource BrandForegroundBrush}"/>
                    <TextBlock Text="MANAGEMENT" Style="{StaticResource Text.Label}" Foreground="{StaticResource BrandMutedForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
                <TextBlock Text="Secure banking operations for every branch."
                           Style="{StaticResource Text.Display}" Foreground="{StaticResource BrandForegroundBrush}"
                           TextWrapping="Wrap" TextTrimming="None" LineHeight="38"/>
                <TextBlock Text="Customers, accounts and transactions in one place, for authorised DaLanBank staff."
                           Style="{StaticResource Text.Body}" Foreground="{StaticResource BrandMutedForegroundBrush}"
                           Margin="0,16,0,32"/>

                <Border Height="1" Background="{StaticResource BrandDividerBrush}" Margin="0,0,0,24"/>

                <!-- Security points -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <icon:Icon Geometry="{StaticResource Icon.Shield}" Size="18" Foreground="{StaticResource AccentBrush}" StrokeThickness="2"/>
                    <TextBlock Text="Role-based access for every staff member" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}" Foreground="{StaticResource BrandForegroundBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <icon:Icon Geometry="{StaticResource Icon.Lock}" Size="18" Foreground="{StaticResource AccentBrush}" StrokeThickness="2"/>
                    <TextBlock Text="Sessions expire automatically" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}" Foreground="{StaticResource BrandForegroundBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <icon:Icon Geometry="{StaticResource Icon.Key}" Size="18" Foreground="{StaticResource AccentBrush}" StrokeThickness="2"/>
                    <TextBlock Text="Strong passwords, changed on first sign-in" Margin="12,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}" Foreground="{StaticResource BrandForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="© 2026 DaLanBank · For internal use only"
                       Style="{StaticResource Text.Caption}" Foreground="{StaticResource BrandMutedForegroundBrush}"/>
        </Grid>
    </Border>
</UserControl>
