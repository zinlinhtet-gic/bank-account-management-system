<Window x:Class="bams.desktop.Components.ConfirmDialog.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource SansFont}" FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource ForegroundBrush}">
    <!-- Dimmed backdrop over the main window; clicking it cancels. Opened only through IDialogService. -->
    <Grid x:Name="Backdrop" Background="{StaticResource OverlayBrush}" Opacity="0"
          MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">
        <Border x:Name="Card" Style="{StaticResource Card}" Width="420" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{StaticResource PopupShadow}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardOffset" Y="8"/>
            </Border.RenderTransform>
            <StackPanel>
                <!-- Tinted icon circle: red for destructive actions, blue otherwise -->
                <Grid Width="44" Height="44" HorizontalAlignment="Left">
                    <Ellipse x:Name="IconCircle" Fill="{StaticResource SecondaryBrush}"/>
                    <icon:Icon x:Name="IconGlyph" Size="20" StrokeThickness="2"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Heading}" Margin="0,16,0,8"
                           TextWrapping="Wrap" TextTrimming="None"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.BodyMuted}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <!-- IsCancel: Esc closes the dialog as "cancelled". -->
                    <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" IsCancel="True"
                            MinWidth="96" Margin="0,0,8,0"/>
                    <!-- IsDefault: Enter confirms. -->
                    <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" IsDefault="True"
                            MinWidth="96" Click="OnConfirmClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
