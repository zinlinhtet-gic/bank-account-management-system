<UserControl x:Class="bams.desktop.Components.StatCard.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             x:Name="Root">
    <!-- Design: StatCard.tsx. Label (top-left), tinted icon (top-right), big mono value, optional trend + sub text. -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Text.FieldLabel}"
                           Margin="0" VerticalAlignment="Top"/>
                <Grid x:Name="IconBox" Grid.Column="1" Width="32" Height="32">
                    <!-- 12% tint of the accent colour behind the icon -->
                    <Border CornerRadius="{StaticResource Radius}" Background="{Binding AccentBrush, ElementName=Root}" Opacity="0.12"/>
                    <icon:Icon Geometry="{Binding Icon, ElementName=Root}" Size="16"
                               Foreground="{Binding AccentBrush, ElementName=Root}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <TextBlock Text="{Binding Value, ElementName=Root}" Style="{StaticResource Text.MonoLarge}" Margin="0,12,0,0"/>
            <StackPanel x:Name="FooterPanel" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="TrendText" Style="{StaticResource Text.Caption}" FontWeight="Medium" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SubValue, ElementName=Root}" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
