<Window x:Class="bams.desktop.Components.ModalDialog.ModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource SansFont}" FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource ForegroundBrush}">
    <!-- Dimmed backdrop over the (blurred) main window. Opened only through IDialogService.ShowDialog. -->
    <Grid x:Name="Backdrop" Background="{StaticResource OverlayBrush}" Opacity="0"
          MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">
        <Border x:Name="Card" Style="{StaticResource Card}" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                Effect="{StaticResource PopupShadow}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardOffset" Y="8"/>
            </Border.RenderTransform>
            <!-- The dialog ViewModel; its view comes from Views/DialogTemplates.xaml. -->
            <ContentPresenter x:Name="Body"/>
        </Border>
    </Grid>
</Window>
