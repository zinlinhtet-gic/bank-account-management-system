<UserControl x:Class="bams.desktop.Components.PasswordInput.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             x:Name="Root">
    <!-- Themed password field with a show/hide (eye) button. Bind Password to the ViewModel. -->
    <Grid>
        <PasswordBox x:Name="HiddenBox" Style="{StaticResource Input.Password}" Padding="10,0,40,0"
                     t:ThemeAssist.HasError="{Binding HasError, ElementName=Root}"
                     PasswordChanged="OnHiddenBoxPasswordChanged"/>
        <TextBox x:Name="VisibleBox" Style="{StaticResource Input.Text}" Padding="10,0,40,0"
                 t:ThemeAssist.HasError="{Binding HasError, ElementName=Root}"
                 Visibility="Collapsed" TextChanged="OnVisibleBoxTextChanged"/>
        <Button x:Name="ToggleButton" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Margin="0,0,4,0"
                t:ThemeAssist.Icon="{StaticResource Icon.Eye}" ToolTip="Show password"
                Focusable="False" Click="OnToggleVisibilityClick"/>
    </Grid>
</UserControl>
