<UserControl x:Class="bams.desktop.Components.AccountPicker.AccountPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             x:Name="Root">
    <!--
        Live account search. Type part of an account number; matching accounts are listed under the box.
        Click a match (or arrow keys + Enter) to select it. Editing the text afterwards clears the selection.
    -->
    <Grid>
        <TextBox x:Name="Input" Style="{StaticResource Input.Text}"
                 t:ThemeAssist.Placeholder="{Binding Placeholder, ElementName=Root}"
                 t:ThemeAssist.HasError="{Binding HasError, ElementName=Root}"/>
        <Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius}" Margin="0,4,0,0"
                    Width="{Binding ActualWidth, ElementName=Input}" MaxHeight="240">
                <Grid>
                    <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource ForegroundBrush}" Padding="2" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnResultClicked"/>
                    <TextBlock x:Name="EmptyText" Text="No matching account" Margin="12,10"
                               Foreground="{StaticResource MutedForegroundBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
