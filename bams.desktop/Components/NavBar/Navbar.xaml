<UserControl x:Class="Bams.Desktop.Components.NavBar.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:bams.desktop.Constants"
             xmlns:local="clr-namespace:Bams.Desktop.Components.NavBar"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             x:Name="Root">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="220"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsCollapsed, ElementName=Root}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="63"
                                                     Duration="0:0:0.22"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="220"
                                                     Duration="0:0:0.22"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- nav items -->
                <RowDefinition Height="Auto"/>
                <!-- user -->
            </Grid.RowDefinitions>

            <!-- ===== Header / Logo ===== -->
            <Border Grid.Row="0"
                    Height="{StaticResource NavBarHeaderHeight}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="28"
                            Height="28"
                            Command="{Binding DataContext.ToggleCollapsedCommand, ElementName=Root}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <Border CornerRadius="4"
                                Background="{StaticResource AccentBrush}">
                            <Path Data="{StaticResource Icon.Bank}"
                                  Stroke="{StaticResource AccentForegroundBrush}"
                                  StrokeThickness="2"
                                  Stretch="Uniform"
                                  Margin="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Border>
                    </Button>

                    <!-- Like {!collapsed && (...)} -->
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.IsCollapsed, ElementName=Root,
                                             Converter={StaticResource BoolToCollapsedVisibility}}">
                        <TextBlock Text="{x:Static constants:BrandConstants.BankShortName}"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="MANAGEMENT"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding DataContext.ToggleCollapsedCommand, ElementName=Root}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Cursor="Hand">
                        <Path Width="14"
                              Height="14"
                              Stroke="{StaticResource MutedForegroundBrush}"
                              StrokeThickness="2"
                              Stretch="Uniform"
                              Data="{Binding DataContext.IsCollapsed, ElementName=Root,
                                     Converter={StaticResource MenuIconConverter}}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Nav Items ===== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,12">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavItem}">
                            <StackPanel>
                                <!-- Main navigation item / parent -->
                                <Button Command="{Binding Command}"
                                        Height="36"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand">

                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <icon:Icon Grid.Column="0"
                                                Size="16"
                                                StrokeThickness="1.8"
                                                Foreground="{StaticResource MutedForegroundBrush}"
                                                Geometry="{Binding IconKey,
                                                    Converter={StaticResource IconKeyToGeometry}}"
                                                VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                Text="{Binding Label}"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeBody}"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource MutedForegroundBrush}"
                                                Visibility="{Binding DataContext.IsCollapsed,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BoolToCollapsedVisibility}}"/>

                                        <!-- Expand/collapse indicator -->
                                        <TextBlock Grid.Column="2"
                                                Text="›"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource MutedForegroundBrush}"
                                                Visibility="{Binding HasChildren,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="RenderTransformOrigin"
                                                            Value="0.5,0.5"/>

                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}"
                                                                    Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>

                                <!-- Child pages -->
                                <ItemsControl ItemsSource="{Binding Children}"
                                            Visibility="{Binding IsExpanded,
                                                Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Command}"
                                                    Height="32"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">

                                                <Border Padding="44,0,12,0">
                                                    <TextBlock Text="{Binding Label}"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource FontSizeCaption}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource MutedForegroundBrush}"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource PrimaryBrush}"/>
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== User ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="{Binding UserInitials}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.IsCollapsed, ElementName=Root,
                                             Converter={StaticResource BoolToCollapsedVisibility}}">
                        <TextBlock Text="{Binding UserName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding UserRole}"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>