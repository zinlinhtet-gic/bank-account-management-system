<UserControl x:Class="Bams.Desktop.Components.NavBar.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bams.Desktop.Components.NavBar"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             x:Name="Root">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="220"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsCollapsed, ElementName=Root}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="63"
                                                     Duration="0:0:0.22"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     To="220"
                                                     Duration="0:0:0.22"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- nav items -->
                <RowDefinition Height="Auto"/>
                <!-- user -->
            </Grid.RowDefinitions>

            <!-- ===== Header / Logo ===== -->
            <Border Grid.Row="0"
                    Height="{StaticResource NavBarHeaderHeight}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="28"
                            Height="28"
                            Command="{Binding DataContext.ToggleCollapsedCommand, ElementName=Root}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <Border CornerRadius="4"
                                Background="{StaticResource AccentBrush}">
                            <Path Data="{StaticResource Icon.Bank}"
                                  Stroke="{StaticResource AccentForegroundBrush}"
                                  StrokeThickness="2"
                                  Stretch="Uniform"
                                  Margin="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Border>
                    </Button>

                    <!-- Like {!collapsed && (...)} -->
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.IsCollapsed, ElementName=Root,
                                             Converter={StaticResource BoolToCollapsedVisibility}}">
                        <TextBlock Text="DaLanBank"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="MANAGEMENT"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding DataContext.ToggleCollapsedCommand, ElementName=Root}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Cursor="Hand">
                        <Path Width="14"
                              Height="14"
                              Stroke="{StaticResource MutedForegroundBrush}"
                              StrokeThickness="2"
                              Stretch="Uniform"
                              Data="{Binding DataContext.IsCollapsed, ElementName=Root,
                                     Converter={StaticResource MenuIconConverter}}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Nav Items ===== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,12">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavItem}">
                            <StackPanel>
                            <Button x:Name="NavItemButton"
                                    Command="{Binding Command}"
                                    Height="36"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="RootGrid"
                                                Background="{TemplateBinding Background}">
                                            <!-- Active left bar -->
                                            <Rectangle Width="3"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,4,0,4"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Fill="{StaticResource AccentBrush}">
                                                <Rectangle.Visibility>
                                                    <MultiBinding Converter="{StaticResource ActiveToVisibility}">
                                                        <Binding Path="DataContext.ActiveItem"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Label"/>
                                                    </MultiBinding>
                                                </Rectangle.Visibility>
                                            </Rectangle>

                                            <Grid Margin="16,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <icon:Icon Grid.Column="0"
                                                           x:Name="TabIcon"
                                                           Size="16"
                                                           StrokeThickness="1.8"
                                                           Foreground="{StaticResource MutedForegroundBrush}"
                                                           Geometry="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>

                                                <TextBlock Grid.Column="1"
                                                           x:Name="TabText"
                                                           Text="{Binding Label}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{StaticResource ForegroundBrush}"
                                                           Visibility="{Binding DataContext.IsCollapsed,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource BoolToCollapsedVisibility}}"/>

                                                <Path Grid.Column="2"
                                                      x:Name="Chevron"
                                                      Width="10"
                                                      Height="10"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource MutedForegroundBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M6,9 L12,15 L18,9"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Visibility="Collapsed">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>

                                            <Border x:Name="ActiveBackground"
                                                    Background="{StaticResource AccentBrush}"
                                                    Opacity="0.08"
                                                    CornerRadius="4"
                                                    Margin="4,2"
                                                    Visibility="Collapsed"
                                                    Panel.ZIndex="-1"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="RootGrid"
                                                        Property="Background"
                                                        Value="{StaticResource SecondaryBrush}"/>
                                                <Setter TargetName="ActiveBackground"
                                                        Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter TargetName="TabIcon"
                                                        Property="Foreground"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="TabText"
                                                        Property="Foreground"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="TabText"
                                                        Property="FontWeight"
                                                        Value="SemiBold"/>
                                            </DataTrigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootGrid"
                                                        Property="Background"
                                                        Value="{StaticResource HoverBrush}"/>
                                            </Trigger>

                                            <!-- The chevron does not fit in the minimized sidebar, so show it only when expanded. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasChildren}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.IsCollapsed,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Minimized sub-menu: the group's child pages in a pop-up beside the sidebar.
                                 StaysOpen=False closes it on any click outside it. -->
                            <Popup PlacementTarget="{Binding ElementName=NavItemButton}"
                                   Placement="Right"
                                   HorizontalOffset="4"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}">
                                <!-- Right/bottom margin leaves room for the drop shadow inside the transparent popup. -->
                                <Border Margin="0,0,12,16"
                                        Padding="0,4"
                                        MinWidth="200"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius}"
                                        Effect="{StaticResource PopupShadow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="16,6,16,6"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedForegroundBrush}"/>

                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:NavItem}">
                                                    <Button Command="{Binding Command}"
                                                            Height="32"
                                                            Background="Transparent"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid x:Name="FlyoutRootGrid"
                                                                      Background="{TemplateBinding Background}">
                                                                    <Rectangle x:Name="FlyoutActiveBar"
                                                                               Width="3"
                                                                               HorizontalAlignment="Left"
                                                                               Margin="0,4,0,4"
                                                                               RadiusX="2"
                                                                               RadiusY="2"
                                                                               Fill="{StaticResource AccentBrush}"
                                                                               Visibility="Collapsed"/>

                                                                    <TextBlock x:Name="FlyoutTabText"
                                                                               Text="{Binding Label}"
                                                                               Margin="16,0"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource ForegroundBrush}"/>
                                                                </Grid>

                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="FlyoutRootGrid"
                                                                                Property="Background"
                                                                                Value="{StaticResource SecondaryBrush}"/>
                                                                        <Setter TargetName="FlyoutActiveBar"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter TargetName="FlyoutTabText"
                                                                                Property="Foreground"
                                                                                Value="{StaticResource AccentBrush}"/>
                                                                        <Setter TargetName="FlyoutTabText"
                                                                                Property="FontWeight"
                                                                                Value="SemiBold"/>
                                                                    </DataTrigger>

                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="FlyoutRootGrid"
                                                                                Property="Background"
                                                                                Value="{StaticResource HoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Sub-menu-->
                            <ItemsControl ItemsSource="{Binding Children}"
                                          Margin="24,0,0,0">
                                <!-- Child pages are text-only, so hide them while the sidebar is minimized
                                     instead of leaving empty rows under the group icon. -->
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.IsCollapsed,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NavItem}">
                                        <Button Command="{Binding Command}"
                                                Height="32"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid x:Name="SubRootGrid"
                                                            Background="{TemplateBinding Background}">
                                                        <Rectangle Width="3"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="0,4,0,4"
                                                                   RadiusX="2"
                                                                   RadiusY="2"
                                                                   Fill="{StaticResource AccentBrush}">
                                                            <Rectangle.Visibility>
                                                                <MultiBinding Converter="{StaticResource ActiveToVisibility}">
                                                                    <Binding Path="DataContext.ActiveItem"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    <Binding Path="Label"/>
                                                                </MultiBinding>
                                                            </Rectangle.Visibility>
                                                        </Rectangle>

                                                        <StackPanel Orientation="Horizontal" Margin="16,7">
                                                            <TextBlock x:Name="SubTabText"
                                                                       Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource MutedForegroundBrush}"
                                                                       Visibility="{Binding DataContext.IsCollapsed,
                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                Converter={StaticResource BoolToCollapsedVisibility}}"/>
                                                        </StackPanel>

                                                        <Border x:Name="SubActiveBackground"
                                                                Background="{StaticResource AccentBrush}"
                                                                Opacity="0.08"
                                                                CornerRadius="4"
                                                                Margin="4,1"
                                                                Visibility="Collapsed"
                                                                Panel.ZIndex="-1"/>
                                                    </Grid>

                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="SubRootGrid"
                                                                    Property="Background"
                                                                    Value="{StaticResource SecondaryBrush}"/>
                                                            <Setter TargetName="SubActiveBackground"
                                                                    Property="Visibility"
                                                                    Value="Visible"/>
                                                            <Setter TargetName="SubTabText"
                                                                    Property="Foreground"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="SubTabText"
                                                                    Property="FontWeight"
                                                                    Value="SemiBold"/>
                                                        </DataTrigger>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SubRootGrid"
                                                                    Property="Background"
                                                                    Value="{StaticResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== User ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="{Binding UserInitials}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.IsCollapsed, ElementName=Root,
                                             Converter={StaticResource BoolToCollapsedVisibility}}">
                        <TextBlock Text="{Binding UserName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding UserRole}"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>