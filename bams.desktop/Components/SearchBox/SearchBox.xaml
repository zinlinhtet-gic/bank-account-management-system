<UserControl x:Class="bams.desktop.Components.SearchBox.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             x:Name="Root">
    <!--
        Search field. Idle: a plain box with a placeholder. Focused or filled: a search icon button appears on the
        left and the text moves right of it. Enter or a click on the icon runs SearchCommand.
    -->
    <Grid>
        <TextBox x:Name="Input" Style="{StaticResource Input.Text}"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand, ElementName=Root}"/>
            </TextBox.InputBindings>
        </TextBox>
        <!-- Not focusable, so clicking it keeps the caret in the box instead of hiding the icon mid-click. -->
        <Button x:Name="SearchButton" Style="{StaticResource Button.Icon}" HorizontalAlignment="Left" Margin="4,0,0,0"
                t:ThemeAssist.Icon="{StaticResource Icon.Search}" ToolTip="Search" Focusable="False"
                Command="{Binding SearchCommand, ElementName=Root}" Visibility="Collapsed"/>
    </Grid>
</UserControl>
