<UserControl x:Class="bams.desktop.Components.ToastMessage.ToastMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             Loaded="ToastMessage_Loaded"
             Unloaded="ToastMessage_Unloaded">
  <Border x:Name="ToastBorder"
          Visibility="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
          BorderThickness="4,0,0,0"
          CornerRadius="8"
          Padding="14,10"
          MaxWidth="440"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.16" />
    </Border.Effect>
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="!" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" Margin="0,0,12,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Grid.Column="1"
                 Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Foreground="{StaticResource ForegroundBrush}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Content="×"
              Style="{StaticResource Button.Ghost}"
              Padding="6,0"
              MinWidth="28"
              VerticalAlignment="Top"
              Click="Dismiss_Click"
              AutomationProperties.Name="Dismiss notification" />
    </Grid>
  </Border>
</UserControl>
