<Application x:Class="bams.desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:bams.desktop"
             xmlns:conv="clr-namespace:Bams.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:CollapsedWidthConverter x:Key="CollapsedWidthConverter"/>
            <conv:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibility"/>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:MenuIconConverter x:Key="MenuIconConverter"/>
            <conv:ActiveToVisibilityConverter x:Key="ActiveToVisibility"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
        </ResourceDictionary> 
    </Application.Resources>
</Application>
