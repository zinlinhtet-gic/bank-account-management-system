<UserControl x:Class="bams.desktop.Views.Pages.Audit.TransactionAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:b="clr-namespace:bams.desktop.Behaviors"
             xmlns:tx="clr-namespace:bams.desktop.Views.Pages.Transactions"
             xmlns:audit="clr-namespace:bams.desktop.Views.Pages.Audit">

    <!--
        Auditor transaction investigation page.
        DataContext: TransactionAuditViewModel.

        Shared filter
            ↓
        paged transaction list
            ↓ row click
        selected transaction detail
    -->

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- ===== Filters ===== -->

        <tx:TransactionFilterBar
            Grid.Row="0"
            DataContext="{Binding Filter}"/>

        <!-- ===== Error banner ===== -->

        <ContentControl Grid.Row="1"
                        Style="{StaticResource Alert.Danger}"
                        Content="{Binding ErrorMessage}"
                        Margin="0,16,0,0"
                        Visibility="{Binding HasError,
                            Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ===== Transaction list ===== -->

        <Border Grid.Row="2"
                Style="{StaticResource Card.Flush}"
                Margin="0,16,0,0">

            <DockPanel>

                <!-- Table caption / pager / refresh -->

                <Border DockPanel.Dock="Top"
                        Style="{StaticResource Card.Caption}">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">

                            <tx:TransactionPager
                                DataContext="{Binding List}"
                                Margin="0,0,12,0"/>

                            <Button Style="{StaticResource Button.Icon}"
                                    Margin="0,0,8,0"
                                    t:ThemeAssist.Icon="{StaticResource Icon.Refresh}"
                                    ToolTip="Refresh transaction audit list"
                                    t:ThemeAssist.IsLoading="{Binding List.IsLoading}"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Transaction audit"
                                       Style="{StaticResource Text.Title}"
                                       VerticalAlignment="Center"/>

                            <ContentControl
                                Style="{StaticResource Badge.Neutral}"
                                t:ThemeAssist.ShowDot="False"
                                Content="{Binding List.CountText}"
                                Margin="10,0,0,0"/>
                        </StackPanel>

                    </DockPanel>

                </Border>

                <Grid>

                    <DataGrid Style="{StaticResource Table}"
                              BorderThickness="0"
                              Cursor="Hand"
                              ItemsSource="{Binding List.Transactions}"
                              b:DataGridRowClick.Command="{Binding SelectTransactionCommand}">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Transaction no"
                                Binding="{Binding TransactionNo}"
                                Width="210"
                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTextColumn
                                Header="Type"
                                Binding="{Binding TypeText}"
                                Width="150"
                                ElementStyle="{StaticResource Table.Text}"/>

                            <DataGridTemplateColumn
                                Header="Status"
                                Width="120"
                                SortMemberPath="Status">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl
                                            Style="{StaticResource Badge.TransactionStatus}"
                                            Content="{Binding StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Amount (MMK)"
                                Binding="{Binding AmountText}"
                                Width="125"
                                SortMemberPath="Amount"
                                ElementStyle="{StaticResource Table.Text.Mono}"/>

                            <DataGridTextColumn
                                Header="Initiated by"
                                Binding="{Binding InitiatedByText}"
                                Width="170"
                                ElementStyle="{StaticResource Table.Text}"/>

                            <DataGridTextColumn
                                Header="Reference"
                                Binding="{Binding ReferenceText}"
                                Width="*"
                                MinWidth="100"
                                ElementStyle="{StaticResource Table.Text.Muted}"/>

                            <DataGridTextColumn
                                Header="Date"
                                Binding="{Binding TransactionAtText}"
                                Width="160"
                                SortMemberPath="TransactionAt"
                                ElementStyle="{StaticResource Table.Text.Muted}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Empty list state -->

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,72,0,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding List.IsEmpty,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock Text="No transactions found"
                                   Style="{StaticResource Text.Subheading}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Try other filters or clear them with Reset."
                                   Style="{StaticResource Text.BodyMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </DockPanel>

        </Border>

        <!-- ===== Selected transaction detail ===== -->

        <Border Grid.Row="4"
                Style="{StaticResource Card.Flush}">

            <Grid>

                <!-- No transaction selected -->

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasDetail,
                                Converter={StaticResource BoolToCollapsedVisibility}}">

                    <TextBlock Text="Select a transaction"
                               Style="{StaticResource Text.Subheading}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Choose a transaction above to review its audit details."
                               Style="{StaticResource Text.BodyMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- Loading selected transaction -->

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoadingDetail,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="Loading transaction details…"
                               Style="{StaticResource Text.BodyMuted}"/>

                </StackPanel>

                <!-- Full audit detail -->
                <audit:TransactionAuditDetailView
                    DataContext="{Binding Detail}"
                    Visibility="{Binding HasDetail,
                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

            </Grid>

        </Border>

    </Grid>
</UserControl>