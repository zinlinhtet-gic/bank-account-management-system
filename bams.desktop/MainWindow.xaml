<Window x:Class="bams.desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:constants="clr-namespace:bams.desktop.Constants" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:nav="clr-namespace:Bams.Desktop.Components.NavBar" xmlns:header="clr-namespace:Bams.Desktop.Components.Header" xmlns:local="clr-namespace:bams.desktop" xmlns:viewmodels="clr-namespace:bams.desktop.ViewModels" xmlns:pageviewmodels="clr-namespace:bams.desktop.ViewModels.Pages" xmlns:views="clr-namespace:bams.desktop.Views" xmlns:pages="clr-namespace:bams.desktop.Views.Pages" mc:Ignorable="d" Title="{x:Static constants:BrandConstants.BankShortName}" Height="720" Width="1280" FontFamily="{StaticResource SansFont}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource ForegroundBrush}" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <!-- Login View -->
        <ContentControl x:Name="LoginContentControl" Content="{Binding LoginView}" />
        <!-- Change Password View -->
        <ContentControl x:Name="ChangePasswordContentControl" Visibility="Collapsed" />
        <!-- Main Application Shell -->
        <!-- Opaque so pages never need their own background and nothing underneath can show through. -->
        <Grid x:Name="MainAppGrid" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource NavBarHeaderRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <nav:NavBar x:Name="Nav" Grid.RowSpan="2" DataContext="{Binding NavBar}" />
            <header:Header Grid.Row="0" Grid.Column="1" SelectedTitle="{Binding ActiveItem}" />
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}">
                <!-- WPF picks the template whose DataType is the most specific match for CurrentPage. -->
                <ContentControl.Resources>
                    <!-- Fallback placeholder for pages that do not have their own view yet. -->
                    <DataTemplate DataType="{x:Type viewmodels:ViewModelBase}">
                        <pages:GenericPageView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type pageviewmodels:UserManagementViewModel}">
                        <pages:UserManagementView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type pageviewmodels:CustomerListViewModel}">
                        <pages:CustomeistView />
                    </DataTemplate>
                    <!-- <DataTemplate DataType="{x:Type pageviewmodels:CustomerListViewModel}">
                        <pages:CustomerListView/>
                    </DataTemplate> -->
                    <!-- Register each real page here, one DataTemplate per page ViewModel, e.g.:
                    <DataTemplate DataType="{x:Type pageviewmodels:AccountManagementViewModel}">
                        <pages:AccountManagementView/>
                    </DataTemplate>
                    -->
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>