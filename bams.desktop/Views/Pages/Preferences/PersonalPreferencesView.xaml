<UserControl x:Class="bams.desktop.Views.Pages.Preferences.PersonalPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1000">
    <!-- My Preferences page. DataContext: PersonalPreferencesViewModel. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding PageTitle}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.BodyMuted}" Text="{Binding PageDescription}"/>
        </StackPanel>

        <!-- ===== Outcome banners ===== -->
        <ContentControl Grid.Row="1" Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <ContentControl Grid.Row="2" Style="{StaticResource Alert.Success}" Content="{Binding SuccessMessage}" Margin="0,16,0,0"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ===== One row per editable setting: {label} : enable {toggle}, {input} {Save} {Cancel} ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.FieldLabel}"
                                       VerticalAlignment="Center" MinWidth="160"/>
                            <TextBlock Text=":" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Enable" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Style="{StaticResource Input.Check}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBox Style="{StaticResource Input.Text}" Width="200" Margin="0,0,16,0"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsEnabled}"/>
                            <Button Content="Save" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
