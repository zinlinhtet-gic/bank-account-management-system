<UserControl x:Class="bams.desktop.Views.Pages.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:tx="clr-namespace:bams.desktop.Views.Pages.Transactions"
             xmlns:txvm="clr-namespace:bams.desktop.ViewModels.Pages.Transactions">
    <!--
        Transactions page (officers). DataContext: TransactionsViewModel.
        Outcome banners → card with one tab per posting kind and the selected tab's form below it.
        Records and pending-transfer actions are on the Transaction History page.
    -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type txvm:TransactionFormViewModel}">
            <tx:TransactionFormView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Outcome banners ===== -->
        <StackPanel>
            <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ContentControl Style="{StaticResource Alert.Success}" Content="{Binding SuccessMessage}" Margin="0,0,0,16"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ===== Tabs + form ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card.Flush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Tab.Strip}" Padding="12,4,12,0">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Tab}" GroupName="TransactionKind"
                                             Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                             t:ThemeAssist.Icon="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource CardPadding}">
                        <ContentControl Content="{Binding CurrentForm}" Focusable="False"
                                        Visibility="{Binding HasForm, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Loading fresh balances for the chosen tab -->
                        <TextBlock Text="Loading accounts…" Style="{StaticResource Text.BodyMuted}"
                                   Visibility="{Binding IsLoadingForm, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- The form could not be opened; the banner above says why -->
                        <StackPanel HorizontalAlignment="Left"
                                    Visibility="{Binding ShowsFormUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="This form could not be opened." Style="{StaticResource Text.Subheading}"/>
                            <Button Content="Try again" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" t:ThemeAssist.Icon="{StaticResource Icon.Refresh}"
                                    Command="{Binding ReloadFormCommand}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
