<UserControl x:Class="bams.desktop.Views.Pages.Operations.FeeOperationDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="560">
    <!-- Read-only fee record card, hosted by ModalDialog. DataContext: FeeOperationDetailsViewModel. -->

    <StackPanel>
        <!-- Header: icon, title, status, amount -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.Reports}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subheading}"/>
                <ContentControl Style="{StaticResource Badge.OperationStatus}" Content="{Binding Status}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Amount}" Style="{StaticResource Text.MonoLarge}" VerticalAlignment="Top"/>
        </Grid>

        <ContentControl Content="{Binding Account}" ContentTemplate="{StaticResource OperationAccountCardTemplate}" Margin="0,20,0,0"/>

        <Separator Style="{StaticResource Divider}" Margin="0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="FEE TYPE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FeeType}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Text="PERIOD" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Period}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="2" Text="TAX" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tax}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" Text="RULE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Rule}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="4" Text="CALCULATED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CalculatedAt}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="5" Text="DEDUCTED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PostedAt}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="6" Text="ACCRUAL ENTRY" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AccruedTransaction}" Style="{StaticResource Text.Mono}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="7" Text="DEDUCTION POSTING" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <StackPanel Grid.Row="7" Grid.Column="1">
                <TextBlock Text="{Binding PostedTransaction}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                <TextBlock Text="Maintenance fees are deducted quarterly, so one posting can cover several months."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96" IsDefault="True" IsCancel="True"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
