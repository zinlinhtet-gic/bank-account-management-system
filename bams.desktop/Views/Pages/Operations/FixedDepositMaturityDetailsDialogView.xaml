<UserControl x:Class="bams.desktop.Views.Pages.Operations.FixedDepositMaturityDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             xmlns:constants="clr-namespace:bams.desktop.Constants"
             Width="620">
    <!-- Read-only fixed deposit card, hosted by ModalDialog (header and Close button stay put; the details scroll). DataContext: FixedDepositMaturityDetailsViewModel. -->

    <DockPanel>
        <!-- Header: icon, title, status, current principal -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.Bank}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subheading}"/>
                <ContentControl Style="{StaticResource Badge.OperationStatus}" Content="{Binding Status}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentPrincipal}" Style="{StaticResource Text.MonoLarge}" HorizontalAlignment="Right"/>
                <TextBlock Text="Current principal" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" VerticalAlignment="Top" Margin="16,0,0,0"
                    t:ThemeAssist.Icon="{StaticResource Icon.Close}" ToolTip="Close"
                    Command="{Binding CloseCommand}"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <!-- Opens the early-withdrawal quote; only for an active deposit before maturity -->
            <Button Content="Break deposit early" Style="{StaticResource Button.Danger}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding EarlyWithdrawal.ShowQuoteCommand}"
                    Visibility="{Binding EarlyWithdrawal.ShowsStartButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96" IsDefault="True" IsCancel="True"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>

        <!-- Details fill the space between header and footer and scroll when the window is too short -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,20,0,0">
            <StackPanel>
                <!-- Early withdrawal: result, error, then the quote with its confirm buttons. DataContext: FixedDepositEarlyWithdrawalViewModel. -->
                <StackPanel DataContext="{Binding EarlyWithdrawal}">
                    <ContentControl Style="{StaticResource Alert.Success}" Content="{Binding ResultMessage}" Margin="0,0,0,16"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,0,0,16"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Border Style="{StaticResource Card.Compact}" Margin="0,0,0,20"
                            Visibility="{Binding ShowsQuote, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="BREAK DEPOSIT EARLY" Style="{StaticResource Text.Label}"/>
                            <TextBlock Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Text="Interest above the early-withdrawal rate is forfeited. The rest is paid to the payout account and the deposit is closed."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PRINCIPAL" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Principal}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="HELD FOR" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DaysHeld}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="CONTRACT RATE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ContractRate}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="EARLY-WITHDRAWAL RATE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EarlyWithdrawalRate}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Text="INTEREST EARNED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InterestEarned}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Text="INTEREST KEPT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InterestKept}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Text="INTEREST FORFEITED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding InterestForfeited}" Style="{StaticResource Text.Mono}"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="7" Text="PAID TO CUSTOMER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding NetPayout}" Style="{StaticResource Text.Mono}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="to payout account"/>
                                        <Run Text="{Binding PayoutAccountNo, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="REASON (OPTIONAL)" Style="{StaticResource Text.FieldLabel}" Margin="0,8,0,0"/>
                            <TextBox Style="{StaticResource Input.Text}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static constants:TransactionFieldRules.DescriptionMaximumLength}"
                                     t:ThemeAssist.Placeholder="Why the customer is breaking the deposit"/>
                            <TextBlock Text="Only a manager can break a fixed deposit." Style="{StaticResource Text.Hint}"
                                       Visibility="{Binding CanWithdraw, Converter={StaticResource BoolToCollapsedVisibility}}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96"
                                        Command="{Binding HideQuoteCommand}"/>
                                <Button Content="Withdraw early" Style="{StaticResource Button.DangerSolid}" MinWidth="120" Margin="8,0,0,0"
                                        Command="{Binding WithdrawCommand}"
                                        Visibility="{Binding CanWithdraw, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ContentControl Content="{Binding Account}" ContentTemplate="{StaticResource OperationAccountCardTemplate}"/>

                <Separator Style="{StaticResource Divider}" Margin="0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TERM" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Term}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="DAYS LEFT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DaysLeft}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Text="ANNUAL RATE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Rate}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Text="ORIGINAL PRINCIPAL" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OriginalPrincipal}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="4" Text="INTEREST ACCRUED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InterestAccrued}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="5" Text="INTEREST CREDITED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InterestPosted}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="6" Text="INTEREST AT MATURITY" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MaturityInterest}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="7" Text="AT MATURITY" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RenewalInstruction}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="8" Text="PAYOUT ACCOUNT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PayoutAccountNo}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="9" Text="OPENED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding OpenedAt}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>
                </Grid>

                <!-- Month-by-month interest schedule -->
                <TextBlock Text="INTEREST SCHEDULE" Style="{StaticResource Text.Label}" Margin="0,8,0,8"/>
                <TextBlock Text="No interest has been calculated for this deposit yet." Style="{StaticResource Text.BodyMuted}"
                           Visibility="{Binding HasSchedule, Converter={StaticResource BoolToCollapsedVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Schedule}"
                              Visibility="{Binding HasSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Period}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" Style="{StaticResource Text.Mono}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ContentControl Grid.Column="2" Style="{StaticResource Badge.OperationStatus}" Content="{Binding Status}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding PostedAt}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
