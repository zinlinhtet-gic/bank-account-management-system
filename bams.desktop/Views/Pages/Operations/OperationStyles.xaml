<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Styles shared by the Operations pages. Loaded once by App.xaml, after the theme.
    -->

    <!--
        Status badge for an Operations row. The DataContext must have a Status (text) property and the badge content
        is that text. Posted / Active = green, Accrued / Matured = amber, Cancelled = red, others (Waived, Closed) grey.
    -->
    <Style x:Key="Badge.OperationStatus" TargetType="ContentControl" BasedOn="{StaticResource Badge.Neutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Posted">
                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Active">
                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Accrued">
                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Matured">
                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status column used by every Operations table. -->
    <DataTemplate x:Key="OperationStatusCellTemplate">
        <ContentControl Content="{Binding Status}" Style="{StaticResource Badge.OperationStatus}"/>
    </DataTemplate>

    <!-- Customer column: name over customer number. Row needs Customer and CustomerNo. -->
    <DataTemplate x:Key="OperationCustomerCellTemplate">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Customer}" Style="{StaticResource Table.Text}"/>
            <TextBlock Text="{Binding CustomerNo}" Style="{StaticResource Table.Text.Muted}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Account column: account number over account type code. Row needs AccountNo and AccountType. -->
    <DataTemplate x:Key="OperationAccountCellTemplate">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AccountNo}" Style="{StaticResource Table.Text.Code}"/>
            <TextBlock Text="{Binding AccountType}" Style="{StaticResource Table.Text.Muted}"/>
        </StackPanel>
    </DataTemplate>

    <!--
        Customer and account block at the top of every Operations detail card.
        Content: an OperationAccountDisplayModel.
    -->
    <DataTemplate x:Key="OperationAccountCardTemplate">
        <Border Style="{StaticResource Card.Compact}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CUSTOMER" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Text.Title}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CustomerNo}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding CustomerNrc, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding CustomerPhone, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ACCOUNT" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding AccountNo}" Style="{StaticResource Text.Mono}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding AccountType}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                        <Run Text="{Binding AccountStatus, Mode=OneWay}"/>
                        <Run Text="· balance"/>
                        <Run Text="{Binding LedgerBalance, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Fixed deposit row: active deposits maturing soon (IsDueSoon) get an amber background. -->
    <Style x:Key="FixedDepositMaturityRow" TargetType="DataGridRow" BasedOn="{StaticResource Table.Row}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
