<UserControl x:Class="bams.desktop.Views.Pages.Configuration.InterestRateFormDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="560">
    <!--
        Create / edit interest rate rule form, hosted by ModalDialog. DataContext: InterestRateFormViewModel.
        Enter saves (default button); Esc cancels unless a save is running.
    -->
    <StackPanel>
        <!-- Header: tinted icon + title + subtitle -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon x:Name="HeaderIcon" Size="20" StrokeThickness="2" Foreground="{StaticResource PrimaryBrush}"
                           Geometry="{StaticResource Icon.Plus}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Fields: locked while saving -->
        <Grid Margin="0,24,0,0" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: account type + status -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="ACCOUNT TYPE" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox x:Name="AccountTypeCombo" Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose an account type"
                          ItemsSource="{Binding AccountTypes}"
                          SelectedItem="{Binding SelectedAccountType, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasAccountTypeError}"/>
                <TextBlock Text="{Binding AccountTypeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasAccountTypeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="STATUS" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose a status"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasStatusError}"/>
                <TextBlock Text="{Binding StatusError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasStatusError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 1: term in days / months (optional; leave one blank) -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="TERM (DAYS, OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 30"
                         Text="{Binding TermDaysText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="TERM (MONTHS, OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 12"
                         Text="{Binding TermMonthsText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Row 2: annual rate + early withdrawal rate -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="ANNUAL RATE %" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 6.5"
                         Text="{Binding AnnualRateText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasAnnualRateError}"/>
                <TextBlock Text="{Binding AnnualRateError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasAnnualRateError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="EARLY WITHDRAWAL RATE % (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 2.0"
                         Text="{Binding EarlyWithdrawalRateText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasEarlyWithdrawalRateError}"/>
                <TextBlock Text="{Binding EarlyWithdrawalRateError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasEarlyWithdrawalRateError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 3: balance range (optional) -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="MIN BALANCE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 100000"
                         Text="{Binding BalanceMinText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasBalanceMinError}"/>
                <TextBlock Text="{Binding BalanceMinError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasBalanceMinError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="MAX BALANCE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 5000000"
                         Text="{Binding BalanceMaxText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasBalanceMaxError}"/>
                <TextBlock Text="{Binding BalanceMaxError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasBalanceMaxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 4: effective date range -->
            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="EFFECTIVE FROM" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding EffectiveFrom, Mode=TwoWay}"
                            t:ThemeAssist.HasError="{Binding HasEffectiveFromError}"/>
                <TextBlock Text="{Binding EffectiveFromError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasEffectiveFromError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="EFFECTIVE TO (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding EffectiveTo, Mode=TwoWay}"
                            t:ThemeAssist.HasError="{Binding HasEffectiveToError}"/>
                <TextBlock Text="{Binding EffectiveToError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasEffectiveToError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Notices -->
        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding SaveText}" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
