<UserControl x:Class="bams.desktop.Views.Pages.Configuration.FeeRateFormDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="560">
    <!--
        Create / edit fee rule form, hosted by ModalDialog. DataContext: FeeRateFormViewModel.
        Enter saves (default button); Esc cancels unless a save is running.
    -->
    <StackPanel>
        <!-- Header: tinted icon + title + subtitle -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon x:Name="HeaderIcon" Size="20" StrokeThickness="2" Foreground="{StaticResource PrimaryBrush}"
                           Geometry="{StaticResource Icon.Plus}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Fields: locked while saving -->
        <Grid Margin="0,24,0,0" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: account type + fee type -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="ACCOUNT TYPE" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox x:Name="AccountTypeCombo" Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose an account type"
                          ItemsSource="{Binding AccountTypes}"
                          SelectedItem="{Binding SelectedAccountType, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasAccountTypeError}"/>
                <TextBlock Text="{Binding AccountTypeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasAccountTypeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="FEE TYPE" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose a fee type"
                          ItemsSource="{Binding FeeTypeOptions}"
                          SelectedItem="{Binding SelectedFeeType, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasFeeTypeError}"/>
                <TextBlock Text="{Binding FeeTypeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasFeeTypeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 1: amount + percentage (optional; a fee rule may use either) -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="AMOUNT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 5000"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasAmountError}"/>
                <TextBlock Text="{Binding AmountError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasAmountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="PERCENTAGE % (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1.5"
                         Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasPercentageError}"/>
                <TextBlock Text="{Binding PercentageError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasPercentageError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 2: fee range (optional) -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="MINIMUM FEE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1000"
                         Text="{Binding MinimumFeeText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMinimumFeeError}"/>
                <TextBlock Text="{Binding MinimumFeeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMinimumFeeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="MAXIMUM FEE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 20000"
                         Text="{Binding MaximumFeeText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMaximumFeeError}"/>
                <TextBlock Text="{Binding MaximumFeeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMaximumFeeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 3: tax rate + status -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="TAX RATE % (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 5"
                         Text="{Binding TaxRateText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasTaxRateError}"/>
                <TextBlock Text="{Binding TaxRateError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasTaxRateError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="STATUS" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose a status"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasStatusError}"/>
                <TextBlock Text="{Binding StatusError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasStatusError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 4: effective date range -->
            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="EFFECTIVE FROM" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding EffectiveFrom, Mode=TwoWay}"
                            t:ThemeAssist.HasError="{Binding HasEffectiveFromError}"/>
                <TextBlock Text="{Binding EffectiveFromError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasEffectiveFromError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="EFFECTIVE TO (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding EffectiveTo, Mode=TwoWay}"
                            t:ThemeAssist.HasError="{Binding HasEffectiveToError}"/>
                <TextBlock Text="{Binding EffectiveToError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasEffectiveToError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Notices -->
        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding SaveText}" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
