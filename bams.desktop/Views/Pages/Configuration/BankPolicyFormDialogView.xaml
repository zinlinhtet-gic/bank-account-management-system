<UserControl x:Class="bams.desktop.Views.Pages.Configuration.BankPolicyFormDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="600">
    <!--
        Create / edit bank policy (account type) form, hosted by ModalDialog. DataContext: BankPolicyFormViewModel.
        Enter saves (default button); Esc cancels unless a save is running.
    -->
    <StackPanel>
        <!-- Header: tinted icon + title + subtitle -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon x:Name="HeaderIcon" Size="20" StrokeThickness="2" Foreground="{StaticResource PrimaryBrush}"
                           Geometry="{StaticResource Icon.Plus}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Fields: locked while saving -->
        <Grid Margin="0,24,0,0" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: code + name -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="CODE" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="CodeBox" Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. NORMAL_SAVING"
                         Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasCodeError}"/>
                <TextBlock Text="{Binding CodeError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasCodeError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="NAME" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. Normal Saving"
                         Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasNameError}"/>
                <TextBlock Text="{Binding NameError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 1: category + status -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="CATEGORY" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose a category"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasCategoryError}"/>
                <TextBlock Text="{Binding CategoryError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasCategoryError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="STATUS" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose a status"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding HasStatusError}"/>
                <TextBlock Text="{Binding StatusError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasStatusError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 2: balance range -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="MIN OPENING BALANCE" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 10000"
                         Text="{Binding MinimumOpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMinimumOpeningBalanceError}"/>
                <TextBlock Text="{Binding MinimumOpeningBalanceError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMinimumOpeningBalanceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="MIN MAINTAINED BALANCE" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 5000"
                         Text="{Binding MinimumMaintainedBalanceText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMinimumMaintainedBalanceError}"/>
                <TextBlock Text="{Binding MinimumMaintainedBalanceError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMinimumMaintainedBalanceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 3: transaction limits (optional) -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="DAILY LIMIT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1000000"
                         Text="{Binding DailyTransactionLimitText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasDailyTransactionLimitError}"/>
                <TextBlock Text="{Binding DailyTransactionLimitError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasDailyTransactionLimitError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="MONTHLY LIMIT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 10000000"
                         Text="{Binding MonthlyTransactionLimitText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMonthlyTransactionLimitError}"/>
                <TextBlock Text="{Binding MonthlyTransactionLimitError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMonthlyTransactionLimitError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 4: weekly limit + daily cash-withdrawal limit -->
            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="WEEKLY LIMIT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 5000000"
                         Text="{Binding WeeklyTransactionLimitText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasWeeklyTransactionLimitError}"/>
                <TextBlock Text="{Binding WeeklyTransactionLimitError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasWeeklyTransactionLimitError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="DAILY WITHDRAWAL LIMIT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1000000"
                         Text="{Binding DailyWithdrawalLimitText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasDailyWithdrawalLimitError}"/>
                <TextBlock Text="{Binding DailyWithdrawalLimitError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasDailyWithdrawalLimitError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 5: minimum cash deposit + minimum cash withdrawal -->
            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="MINIMUM DEPOSIT (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1000"
                         Text="{Binding MinimumDepositAmountText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMinimumDepositAmountError}"/>
                <TextBlock Text="{Binding MinimumDepositAmountError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMinimumDepositAmountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="MINIMUM WITHDRAWAL (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 1000"
                         Text="{Binding MinimumWithdrawalAmountText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasMinimumWithdrawalAmountError}"/>
                <TextBlock Text="{Binding MinimumWithdrawalAmountError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasMinimumWithdrawalAmountError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Row 6: referer counts -->
            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="CITIZEN REFERERS REQUIRED" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 0"
                         Text="{Binding CitizenRequiredReferText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasCitizenRequiredReferError}"/>
                <TextBlock Text="{Binding CitizenRequiredReferError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasCitizenRequiredReferError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="FOREIGNER REFERERS REQUIRED" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. 0"
                         Text="{Binding ForeignRequiredReferText, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.HasError="{Binding HasForeignRequiredReferError}"/>
                <TextBlock Text="{Binding ForeignRequiredReferError}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding HasForeignRequiredReferError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Permissions -->
        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="PERMISSIONS" Style="{StaticResource Text.FieldLabel}"/>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox Content="Allow withdrawal" Style="{StaticResource Input.Check}" Margin="0,0,20,8"
                          IsChecked="{Binding AllowWithdrawal}"/>
                <CheckBox Content="Allow transfer" Style="{StaticResource Input.Check}" Margin="0,0,20,8"
                          IsChecked="{Binding AllowTransfer}"/>
                <CheckBox Content="Allow partial withdrawal" Style="{StaticResource Input.Check}" Margin="0,0,20,8"
                          IsChecked="{Binding AllowPartialWithdrawal}"/>
                <CheckBox Content="Allow citizen" Style="{StaticResource Input.Check}" Margin="0,0,20,8"
                          IsChecked="{Binding AllowCitizen}"/>
                <CheckBox Content="Allow foreigner" Style="{StaticResource Input.Check}" Margin="0,0,20,8"
                          IsChecked="{Binding AllowForeigner}"/>
            </WrapPanel>
        </StackPanel>

        <!-- Notices -->
        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding SaveText}" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
