<UserControl x:Class="bams.desktop.Views.Pages.Configuration.InterestRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1000">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,20">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding PageTitle}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitleTextStyle}" Text="{Binding PageDescription}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="32,0,32,32" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="Interest Rate Rules"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Margin="8,0,0,0" Content="+ Create" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ConfigDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.8*" Binding="{Binding AccountType}" Header="Account Type"/>
                        <DataGridTextColumn Width="1*" Binding="{Binding Term}" Header="Term"/>
                        <DataGridTextColumn Width="1.1*" Binding="{Binding AnnualRate}" Header="Annual Rate %"/>
                        <DataGridTextColumn Width="1.1*" Binding="{Binding MinBalance}" Header="Min Balance"/>
                        <DataGridTextColumn Width="1.1*" Binding="{Binding MaxBalance}" Header="Max Balance"/>
                        <DataGridTextColumn Width="0.8*" Binding="{Binding Status}" Header="Status"/>
                        <DataGridTemplateColumn Width="0.8*" Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Update" Style="{StaticResource TableActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SectionNoteTextStyle}"
                    Text="No interest rate rules yet."
                    Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
