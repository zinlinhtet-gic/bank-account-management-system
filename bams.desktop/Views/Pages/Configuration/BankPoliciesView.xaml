<UserControl x:Class="bams.desktop.Views.Pages.Configuration.BankPoliciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1000">
    <!-- Bank Policies page. DataContext: BankPoliciesViewModel. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding PageTitle}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.BodyMuted}" Text="{Binding PageDescription}"/>
        </StackPanel>

        <!-- ===== Bank policies table ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card.Flush}" Margin="0,16,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Icon}" Margin="0,0,8,0"
                                    t:ThemeAssist.Icon="{StaticResource Icon.Refresh}" ToolTip="Refresh list"/>
                            <Button Content="New policy" Style="{StaticResource Button.Primary}" t:ThemeAssist.Size="Small"
                                    t:ThemeAssist.Icon="{StaticResource Icon.Plus}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Bank policies" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            <ContentControl Style="{StaticResource Badge.Neutral}" t:ThemeAssist.ShowDot="False"
                                            Content="{Binding CountText}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <DataGrid Style="{StaticResource Table}" BorderThickness="0"
                              ItemsSource="{Binding Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account type" Binding="{Binding AccountType}" Width="1.3*"
                                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTextColumn Header="Min opening balance" Binding="{Binding MinOpeningBalance}" Width="*"
                                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTextColumn Header="Min maintained balance" Binding="{Binding MinMaintainedBalance}" Width="*"
                                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTextColumn Header="Daily limit" Binding="{Binding DailyLimit}" Width="*"
                                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding Status}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Neutral}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="90" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Arrow">
                                            <Button Style="{StaticResource Button.Icon}" ToolTip="Edit policy"
                                                    t:ThemeAssist.Icon="{StaticResource Icon.Edit}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state under the column headers -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="No bank policies yet" Style="{StaticResource Text.Subheading}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click New policy to add the first one." Style="{StaticResource Text.BodyMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
