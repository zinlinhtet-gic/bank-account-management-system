<UserControl x:Class="bams.desktop.Views.Pages.Users.UserDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="460">
    <!-- Read-only user detail card, hosted by ModalDialog. DataContext: UserDetailsViewModel. -->

    <StackPanel>
        <!-- Header: icon, full name, badges -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.Users}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding User.FullName}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ContentControl Style="{StaticResource Badge.Info}" Content="{Binding RoleName}"/>
                    <ContentControl x:Name="StatusBadge" Style="{StaticResource Badge.Success}" Content="{Binding StatusText}" Margin="6,0,0,0"/>
                    <ContentControl Style="{StaticResource Badge.Primary}" Content="You" Margin="6,0,0,0"
                                    Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Separator Style="{StaticResource Divider}" Margin="0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="7" Text="ACTIVITY" Style="{StaticResource Text.Label}" Margin="0,14,0,0"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PresenceText}" Style="{StaticResource Text.Body}" Margin="0,12,0,0"/>

            <TextBlock Grid.Row="0" Text="USERNAME" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding User.Username}" Style="{StaticResource Text.Mono}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Text="EMAIL" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User.Email}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="2" Text="PHONE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhoneText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" Text="LAST SIGN-IN" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastLoginText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="4" Text="PASSWORD" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PasswordText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="5" Text="CREATED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="6" Text="LAST UPDATED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Text.Body}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CloseCommand}"/>
            <Button Content="Edit user" Style="{StaticResource Button.Primary}" MinWidth="96" IsDefault="True"
                    t:ThemeAssist.Icon="{StaticResource Icon.Edit}"
                    Command="{Binding EditCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
