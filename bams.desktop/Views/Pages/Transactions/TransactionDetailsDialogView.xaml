<UserControl x:Class="bams.desktop.Views.Pages.Transactions.TransactionDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="540">
    <!-- Read-only transaction detail card, hosted by ModalDialog. DataContext: TransactionDetailsViewModel. -->

    <StackPanel>
        <!-- Header: icon, transaction number, badges -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.Transactions}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Transaction.TransactionNo}" Style="{StaticResource Text.Mono}" FontSize="{StaticResource FontSizeSubheading}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ContentControl Style="{StaticResource Badge.Info}" Content="{Binding TypeText}"/>
                    <ContentControl Style="{StaticResource Badge.TransactionStatus}" Content="{Binding StatusText}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Text.MonoLarge}" VerticalAlignment="Top"/>
        </Grid>

        <Separator Style="{StaticResource Divider}" Margin="0,20"/>

        <!-- Scroll when entries and transfer details make the card taller than the window -->
        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DATE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TransactionAtText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="POSTED" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PostedAtText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Text="REFERENCE" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Text="DESCRIPTION" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DescriptionText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="4" Text="REFUND" Style="{StaticResource Text.Label}" Margin="0,2,0,0"
                               Visibility="{Binding IsRefund, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RefundOfText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"
                               Visibility="{Binding IsRefund, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- NRC transfer -->
                <Border Style="{StaticResource Card.Compact}" Margin="0,4,0,12"
                        Visibility="{Binding HasNrcTransfer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="NRC transfer" Style="{StaticResource Text.Title}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="SENDER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SenderText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="RECEIVER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReceiverText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="PICKUP" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PickupText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Text="COLLECT AT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PickupLocationText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Text="PAYMENT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PaymentText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Interbank transfer -->
                <Border Style="{StaticResource Card.Compact}" Margin="0,4,0,12"
                        Visibility="{Binding HasInterbankTransfer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="Interbank transfer" Style="{StaticResource Text.Title}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="TO" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeneficiaryText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="GATEWAY" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GatewayText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="SETTLEMENT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettlementText}" Style="{StaticResource Text.Body}"/>
                    </Grid>
                </Border>

                <!-- Account entries -->
                <StackPanel Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="ACCOUNT ENTRIES" Style="{StaticResource Text.Label}" Margin="0,4,0,8"/>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountNo}" Style="{StaticResource Text.Mono}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="Balance after"/>
                                            <Run Text="{Binding BalanceAfterText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Style="{StaticResource Badge.EntryType}" Content="{Binding EntryTypeText}"
                                                    VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Text.Mono}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Margin="12,-4,0,0" VerticalAlignment="Top"
                                            ToolTip="Open this account's statement"
                                            t:ThemeAssist.Icon="{StaticResource Icon.Reports}"
                                            Command="{Binding DataContext.ShowStatementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96" IsDefault="True" IsCancel="True"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
