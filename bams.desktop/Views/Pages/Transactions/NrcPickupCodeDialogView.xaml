<UserControl x:Class="bams.desktop.Views.Pages.Transactions.NrcPickupCodeDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="440">
    <!--
        One-time display of a new NRC transfer's pickup code, hosted by ModalDialog. DataContext: NrcPickupCodeViewModel.
    -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SuccessSoftBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.Key}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NRC transfer created" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card.Compact}" Margin="0,24,0,0" Background="{StaticResource MutedBrush}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PICKUP CODE" Style="{StaticResource Text.FieldLabel}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PickupCode}" Style="{StaticResource Text.MonoLarge}" FontSize="36"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Text.BodyMuted}" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Run Text="Collect at"/>
                    <Run Text="{Binding PickupLocation, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <ContentControl Style="{StaticResource Alert.Warning}" Margin="0,16,0,0"
                        Content="Give this code to the sender now. It is shown only once and cannot be looked up later. The receiver needs it and their NRC to collect the money."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CopyButton" Content="Copy code" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    t:ThemeAssist.Icon="{StaticResource Icon.Copy}" Click="OnCopyClick"/>
            <Button Content="Done" Style="{StaticResource Button.Primary}" MinWidth="96" IsDefault="True"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
