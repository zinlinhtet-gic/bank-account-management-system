<UserControl x:Class="bams.desktop.Views.Pages.Transactions.AccountStatementDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             xmlns:tx="clr-namespace:bams.desktop.Views.Pages.Transactions"
             Width="960">
    <!--
        Account statement, hosted by ModalDialog. DataContext: AccountStatementViewModel.
        Date range → entries table (newest first, balance after each) with the shared pager.
    -->
    <StackPanel>
        <!-- Header: icon, account number, entry count; date range on the right -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel Width="140">
                    <TextBlock Text="FROM" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Width="140" Margin="16,0,0,0">
                    <TextBlock Text="TO" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding DateTo, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                    <icon:Icon Geometry="{StaticResource Icon.Reports}" Size="20" StrokeThickness="2"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Account statement" Style="{StaticResource Text.Heading}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AccountNo}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                        <ContentControl Style="{StaticResource Badge.Neutral}" t:ThemeAssist.ShowDot="False"
                                        Content="{Binding CountText}" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

        <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Entries -->
        <Border Style="{StaticResource Card.Flush}" Margin="0,20,0,0">
            <Grid>
                <DataGrid Style="{StaticResource Table}" BorderThickness="0" Height="380"
                          ItemsSource="{Binding Lines}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="175"
                                            ElementStyle="{StaticResource Table.Text.Muted}"/>
                        <DataGridTextColumn Header="Transaction no" Binding="{Binding TransactionNo}" Width="235"
                                            ElementStyle="{StaticResource Table.Text.Code}"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding TypeText}" Width="*"
                                            ElementStyle="{StaticResource Table.Text}"/>
                        <DataGridTemplateColumn Header="Entry" Width="100" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Badge.EntryType}" Content="{Binding EntryTypeText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Amount (MMK)" Binding="{Binding AmountText}" Width="125"
                                            ElementStyle="{StaticResource Table.Text.Mono}"/>
                        <DataGridTextColumn Header="Balance (MMK)" Binding="{Binding BalanceAfterText}" Width="135"
                                            ElementStyle="{StaticResource Table.Text.Mono}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="No entries" Style="{StaticResource Text.Subheading}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nothing was posted to this account in the chosen dates." Style="{StaticResource Text.BodyMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96"
                    IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}"/>
            <tx:TransactionPager HorizontalAlignment="Left"/>
        </DockPanel>
    </StackPanel>
</UserControl>
