<UserControl x:Class="bams.desktop.Views.Pages.Transactions.NrcPickupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="480">
    <!--
        NRC pickup, hosted by ModalDialog. DataContext: NrcPickupFormViewModel.
        Takes the collector's name and NRC from their NRC card and the six-digit pickup code; pays out in cash.
    -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.UserCheck}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NRC pickup" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Transfer summary. The designated receiver is not shown: the officer enters the identity from the
             collector's NRC card and the server checks it. -->
        <Border Style="{StaticResource Card.Compact}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SENDER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SenderText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="CODE VALID TO" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExpiresText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="COLLECT AT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PickupLocationText}" Style="{StaticResource Text.Body}"/>
            </Grid>
        </Border>

        <ContentControl Style="{StaticResource Alert.Warning}" Margin="0,16,0,0" Content="{Binding AttemptsWarning}"
                        Visibility="{Binding HasAttemptsWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Margin="0,20,0,0" IsEnabled="{Binding IsNotBusy}">
            <TextBlock Text="COLLECTOR'S NAME" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox x:Name="ReceiverNameBox" Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="As printed on the NRC card"
                     MaxLength="{Binding PersonNameMaximumLength}"
                     Text="{Binding ReceiverName, UpdateSourceTrigger=PropertyChanged}"
                     t:ThemeAssist.HasError="{Binding ReceiverNameError.HasError}"/>
            <TextBlock Text="{Binding ReceiverNameError.Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                       Visibility="{Binding ReceiverNameError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="COLLECTOR'S NRC" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,0"/>
            <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="As printed on the NRC card"
                     FontFamily="{StaticResource MonoFont}" MaxLength="{Binding NrcMaximumLength}"
                     Text="{Binding ReceiverNrc, UpdateSourceTrigger=PropertyChanged}"
                     t:ThemeAssist.HasError="{Binding ReceiverNrcError.HasError}"/>
            <TextBlock Text="Only the receiver the sender named can collect. Cash is paid out over the counter."
                       Style="{StaticResource Text.Hint}"
                       Visibility="{Binding ReceiverNrcError.HasError, Converter={StaticResource BoolToCollapsedVisibility}}"/>
            <TextBlock Text="{Binding ReceiverNrcError.Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                       Visibility="{Binding ReceiverNrcError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="PICKUP CODE" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,0"/>
            <TextBox x:Name="PickupCodeBox" Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="6 digits"
                     FontFamily="{StaticResource MonoFont}" MaxLength="{Binding PickupCodeLength}"
                     Text="{Binding PickupCode, UpdateSourceTrigger=PropertyChanged}"
                     t:ThemeAssist.HasError="{Binding PickupCodeError.HasError}"/>
            <TextBlock Text="{Binding PickupCodeError.Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                       Visibility="{Binding PickupCodeError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="CASH POSITION" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,0"/>
            <TextBlock Text="Payout will be recorded in your current open teller session automatically."
                       Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CashSessionError.Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                       Visibility="{Binding CashSessionError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Complete pickup" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}" t:ThemeAssist.Icon="{StaticResource Icon.Check}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
