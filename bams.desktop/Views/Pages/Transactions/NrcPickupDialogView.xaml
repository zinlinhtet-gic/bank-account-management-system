<UserControl x:Class="bams.desktop.Views.Pages.Transactions.NrcPickupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="480">
    <!--
        NRC pickup, hosted by ModalDialog. DataContext: NrcPickupFormViewModel.
        Shows who may collect the money, then takes the six-digit pickup code.
    -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon Geometry="{StaticResource Icon.UserCheck}" Size="20" StrokeThickness="2"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NRC pickup" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Who may collect: the officer compares this with the NRC card presented -->
        <Border Style="{StaticResource Card.Compact}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RECEIVER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReceiverName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="NRC" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverNrc}" Style="{StaticResource Text.Mono}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="SENDER" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SenderText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="CODE VALID TO" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpiresText}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Text="COLLECT AT" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PickupLocationText}" Style="{StaticResource Text.Body}"/>
            </Grid>
        </Border>

        <ContentControl Style="{StaticResource Alert.Warning}" Margin="0,16,0,0" Content="{Binding AttemptsWarning}"
                        Visibility="{Binding HasAttemptsWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Margin="0,20,0,0" IsEnabled="{Binding IsNotBusy}">
            <TextBlock Text="PICKUP CODE" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox x:Name="PickupCodeBox" Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="6 digits"
                     FontFamily="{StaticResource MonoFont}" MaxLength="{Binding PickupCodeLength}"
                     Text="{Binding PickupCode, UpdateSourceTrigger=PropertyChanged}"
                     t:ThemeAssist.HasError="{Binding PickupCodeError.HasError}"/>
            <TextBlock Text="Check the receiver's NRC card before entering the code."
                       Style="{StaticResource Text.Hint}"
                       Visibility="{Binding PickupCodeError.HasError, Converter={StaticResource BoolToCollapsedVisibility}}"/>
            <TextBlock Text="{Binding PickupCodeError.Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"
                       Visibility="{Binding PickupCodeError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="PAY OUT" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Style="{StaticResource Input.Radio}" GroupName="NrcPayout"
                             IsChecked="{Binding IsPaidInCash, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="Cash" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
                        <TextBlock Text="Over the counter" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="2" Style="{StaticResource Input.Radio}" GroupName="NrcPayout"
                             IsChecked="{Binding IsPaidIntoAccount, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="Into their account" Style="{StaticResource Text.Body}" FontWeight="Medium"/>
                        <TextBlock Text="If they bank with us" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsPaidIntoAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="RECEIVER'S ACCOUNT" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.Select}" t:ThemeAssist.Placeholder="Choose an account"
                          ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding DestinationAccount, Mode=TwoWay}"
                          t:ThemeAssist.HasError="{Binding DestinationAccountError.HasError}"/>
                <TextBlock Text="{Binding DestinationAccountError.Message}" Style="{StaticResource Text.Error}"
                           Visibility="{Binding DestinationAccountError.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>

        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Complete pickup" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}" t:ThemeAssist.Icon="{StaticResource Icon.Check}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
