<UserControl x:Class="bams.desktop.Views.Pages.Transactions.PendingTransferActionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             Width="460">
    <!--
        Cancel an NRC transfer, or record an interbank transfer as settled / failed. Hosted by ModalDialog.
        DataContext: PendingTransferActionViewModel. Refunding actions use the danger look, like the confirm dialog.
    -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <Ellipse x:Name="IconCircle" Fill="{StaticResource SecondaryBrush}"/>
                <icon:Icon x:Name="HeaderIcon" Size="20" StrokeThickness="2" Foreground="{StaticResource PrimaryBrush}"
                           Geometry="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,20,0,0"/>

        <StackPanel Margin="0,20,0,0" IsEnabled="{Binding IsNotBusy}">
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding ShowsGatewayReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding GatewayReferenceLabel}" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="From the payment gateway"
                         Text="{Binding GatewayReference, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding ShowsSettlementReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="SETTLEMENT REFERENCE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="e.g. the clearing batch number"
                         Text="{Binding SettlementReference, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsReason, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="REASON (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="Saved on the refund"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <ContentControl Style="{StaticResource Alert.Danger}" Margin="0,20,0,0" Content="{Binding FormError}"
                        Visibility="{Binding HasFormError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{Binding CancelText}" Style="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button x:Name="SubmitButton" Content="{Binding SaveText}" Style="{StaticResource Button.Primary}" MinWidth="120" IsDefault="True"
                    t:ThemeAssist.IsLoading="{Binding IsBusy}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
