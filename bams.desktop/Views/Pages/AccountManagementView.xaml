<UserControl x:Class="bams.desktop.Views.Pages.AccountManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid Visibility="{Binding IsListScreen, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Accounts" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="Search, filter, and manage account records" Margin="0,4,0,0" Foreground="{StaticResource MutedForegroundBrush}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Open account" Style="{StaticResource Button.Primary}" Command="{Binding OpenCreateCommand}"/>
            </DockPanel>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <WrapPanel VerticalAlignment="Center">
                    <TextBox Width="260" Margin="0,0,10,0" Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="Account number"/>
                    <ComboBox Width="220" Margin="0,0,10,0" Style="{StaticResource Input.Select}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedFilterType}" DisplayMemberPath="Name" t:ThemeAssist.Placeholder="All account types"/>
                    <ComboBox Width="165" Margin="0,0,10,0" Style="{StaticResource Input.Select}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" t:ThemeAssist.Placeholder="All statuses"/>
                    <Button Content="Apply filters" Style="{StaticResource Button.Secondary}" Command="{Binding SearchAccountsCommand}"/>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="48" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ACCOUNT NUMBER" Binding="{Binding AccountNo}" Width="2*"/>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding AccountTypeCode}" Width="*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="AVAILABLE BALANCE" Binding="{Binding AvailableBalance, StringFormat={}{0:N2}}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="View" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Load more" Style="{StaticResource Button.Secondary}" Command="{Binding LoadMoreCommand}"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Loading accounts…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>

        <Grid Visibility="{Binding IsCreateScreen, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button Content="Back to accounts" Style="{StaticResource Button.Ghost}" Command="{Binding BackToListCommand}" DockPanel.Dock="Right"/>
                <StackPanel><TextBlock Text="Open an account" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Enter account and holder information" Margin="0,4,0,0" Foreground="{StaticResource MutedForegroundBrush}"/></StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACCOUNT DETAILS" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Text="Account type" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedCreateType}" DisplayMemberPath="Name" t:ThemeAssist.Placeholder="Choose an account type"/>
                            <TextBlock Text="Opening balance" Style="{StaticResource Text.FieldLabel}" Margin="0,14,0,0"/>
                            <TextBox Style="{StaticResource Input.Text}" Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Interest rule" Style="{StaticResource Text.FieldLabel}" Margin="0,14,0,0"/>
                            <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding InterestRateRules}" SelectedItem="{Binding SelectedInterestRateRule}" DisplayMemberPath="DisplayName" t:ThemeAssist.Placeholder="Choose an interest rule"/>
                            <TextBlock Text="Loading interest rulesâ€¦" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,5,0,0" Visibility="{Binding IsLoadingInterestRateRules, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="No interest rules are available for this account type." Foreground="{StaticResource MutedForegroundBrush}" Margin="0,5,0,0" Visibility="{Binding HasNoInterestRateRules, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Visibility="{Binding IsFixedDeposit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Fixed deposit settings" FontWeight="SemiBold" Margin="0,18,0,8"/>
                                <TextBlock Text="Payout account ID" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox Style="{StaticResource Input.Text}" Text="{Binding PayoutAccountId, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Renewal instruction" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,0"/>
                                <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding RenewalInstructions}" SelectedItem="{Binding RenewalInstruction}"/>
                                <CheckBox Content="Calculate interest from current principal" IsChecked="{Binding CalculateFromCurrent}" Margin="0,10,0,0" Style="{StaticResource Input.Check}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACCOUNT HOLDERS" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <CheckBox Content="This is a shared account" IsChecked="{Binding IsSharedAccount}" Style="{StaticResource Input.Check}" Margin="0,0,0,12"/>
                            <TextBlock Text="Primary holder NRC" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox Style="{StaticResource Input.Text}" Text="{Binding HolderNrc1, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Visibility="{Binding IsSharedAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Second holder NRC" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,0"/>
                                <TextBox Style="{StaticResource Input.Text}" Text="{Binding HolderNrc2, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="Holder 1 ownership (%)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding OwnershipPercentage1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Width="180"><TextBlock Text="Holder 2 ownership (%)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding OwnershipPercentage2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Signing rule" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,0"/>
                                <TextBox Style="{StaticResource Input.Text}" Text="{Binding SigningRule, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SUPPORTING DOCUMENTS" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <ComboBox Width="210" Margin="0,0,8,8" Style="{StaticResource Input.Select}" ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}"/>
                                <TextBox Width="190" Margin="0,0,8,8" Style="{StaticResource Input.Text}" Text="{Binding SelectedDocumentNumber, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="Document number"/>
                                <TextBox x:Name="DocumentPathBox" Width="250" Margin="0,0,8,8" Style="{StaticResource Input.Text}" Text="{Binding SelectedDocumentPath, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="File path"/>
                                <Button Content="Browse" Style="{StaticResource Button.Secondary}" Click="BrowseDocument_Click" Margin="0,0,8,8"/>
                                <Button Content="Add" Style="{StaticResource Button.Ghost}" Command="{Binding AddDocumentCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock Text="{Binding DocumentType}"/><TextBlock Text=" — "/><TextBlock Text="{Binding FilePath}"/><Button Content="Remove" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Create account" Style="{StaticResource Button.Primary}" Command="{Binding CreateAccountCommand}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsDetailScreen, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <Button Content="Back to accounts" Style="{StaticResource Button.Ghost}" Command="{Binding BackToListCommand}" DockPanel.Dock="Right"/>
                <StackPanel><TextBlock Text="Account details" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Account profile and current balances" Margin="0,4,0,0" Foreground="{StaticResource MutedForegroundBrush}"/></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Top" MaxWidth="840" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedAccount.AccountNo}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedAccount.AccountTypeCode}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,4,0,18"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,8"><TextBlock Text="STATUS" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.Status}" FontSize="16"/></StackPanel>
                        <StackPanel Margin="0,8"><TextBlock Text="ACCOUNT TYPE ID" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.AccountTypeId}" FontSize="16"/></StackPanel>
                        <StackPanel Margin="0,8"><TextBlock Text="AVAILABLE BALANCE" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.AvailableBalance, StringFormat={}{0:N2}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="0,8"><TextBlock Text="LEDGER BALANCE" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.LedgerBalance, StringFormat={}{0:N2}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Margin="0,8"><TextBlock Text="OPENED" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.OpenedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"/></StackPanel>
                        <StackPanel Margin="0,8"><TextBlock Text="CREATED" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding SelectedAccount.CreatedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
