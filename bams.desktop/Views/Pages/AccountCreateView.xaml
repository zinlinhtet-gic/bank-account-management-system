<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:t="clr-namespace:bams.desktop.Themes" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="bams.desktop.Views.Pages.AccountCreateView" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <UserControl.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />
  </UserControl.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button Content="Back to accounts" Style="{StaticResource Button.Ghost}" Command="{Binding Workflow.BackToListCommand}" DockPanel.Dock="Right" />
      <StackPanel>
        <TextBlock Text="Open an account" Style="{StaticResource Text.Heading}" FontSize="28" />
        <TextBlock Text="Step-by-step account opening" Style="{StaticResource Text.BodyMuted}" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <UniformGrid Columns="5">
        <Button Content="{Binding Workflow.Step1Label}" Foreground="{Binding Workflow.Step1Foreground}" Background="{Binding Workflow.Step1Background}" Command="{Binding Workflow.GoToCreateStepCommand}" CommandParameter="1" Style="{StaticResource Button.Ghost}" Margin="2" />
        <Button Content="{Binding Workflow.Step2Label}" Foreground="{Binding Workflow.Step2Foreground}" Background="{Binding Workflow.Step2Background}" Command="{Binding Workflow.GoToCreateStepCommand}" CommandParameter="2" Style="{StaticResource Button.Ghost}" Margin="2" />
        <Button Content="{Binding Workflow.Step3Label}" Foreground="{Binding Workflow.Step3Foreground}" Background="{Binding Workflow.Step3Background}" Command="{Binding Workflow.GoToCreateStepCommand}" CommandParameter="3" Style="{StaticResource Button.Ghost}" Margin="2" />
        <Button Content="{Binding Workflow.Step4Label}" Foreground="{Binding Workflow.Step4Foreground}" Background="{Binding Workflow.Step4Background}" Command="{Binding Workflow.GoToCreateStepCommand}" CommandParameter="4" Style="{StaticResource Button.Ghost}" Margin="2" />
        <Button Content="{Binding Workflow.Step5Label}" Foreground="{Binding Workflow.Step5Foreground}" Background="{Binding Workflow.Step5Background}" Command="{Binding Workflow.GoToCreateStepCommand}" CommandParameter="5" Style="{StaticResource Button.Ghost}" Margin="2" />
      </UniformGrid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Stretch">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
          <StackPanel>
            <StackPanel Visibility="{Binding Workflow.IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Choose account ownership" Style="{StaticResource Text.Subheading}" Margin="0,0,0,16" />
              <RadioButton Content="Individual" IsChecked="{Binding Workflow.IsIndividualAccount}" GroupName="ownership" Margin="0,6" />
              <RadioButton Content="Shared" IsChecked="{Binding Workflow.IsSharedAccount}" GroupName="ownership" Margin="0,6" />
            </StackPanel>
            <StackPanel Visibility="{Binding Workflow.IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Find customer holders by NRC" Style="{StaticResource Text.Subheading}" Margin="0,0,0,14" />
              <TextBlock Text="Customer NRC" Style="{StaticResource Text.FieldLabel}" />
              <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.HolderNrc1, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Visibility="{Binding Workflow.IsSharedAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Second customer NRC" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,0" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.HolderNrc2, UpdateSourceTrigger=PropertyChanged}" />
                <WrapPanel Margin="0,8">
                  <StackPanel Width="180" Margin="0,0,12,0">
                    <TextBlock Text="First ownership (%)" Style="{StaticResource Text.FieldLabel}" />
                    <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.OwnershipPercentage1}" />
                  </StackPanel>
                  <StackPanel Width="180">
                    <TextBlock Text="Second ownership (%)" Style="{StaticResource Text.FieldLabel}" />
                    <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.OwnershipPercentage2}" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock Text="Signing rule" Style="{StaticResource Text.FieldLabel}" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.SigningRule}" />
              </StackPanel>
              <Button Content="Find customer(s)" Style="{StaticResource Button.Secondary}" Command="{Binding Workflow.LookupCustomersCommand}" Margin="0,12,0,6" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Workflow.Holder1.FullName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Workflow.Holder1.CustomerNo}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder1.NrcNumber}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder1.Phone}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder1.Email}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder2.FullName}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Workflow.Holder2.CustomerNo}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder2.NrcNumber}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder2.Phone}" Foreground="{StaticResource MutedForegroundBrush}" />
              <TextBlock Text="{Binding Workflow.Holder2.Email}" Foreground="{StaticResource MutedForegroundBrush}" />
              <StackPanel Visibility="{Binding Workflow.ShowCustomerRegistrationForm, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,14,0,0">
                <TextBlock Text="Register customer" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Workflow.RegistrationNrc}" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,6" />
                <TextBlock Text="Customer type" Style="{StaticResource Text.FieldLabel}" Margin="0,8,0,0" />
                <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Workflow.CustomerTypes}" SelectedItem="{Binding Workflow.RegistrationCustomerType}" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.RegistrationFullName, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="Full name" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.RegistrationDateOfBirth, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="Date of birth (YYYY-MM-DD)" Margin="0,8,0,0" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.RegistrationPhone}" t:ThemeAssist.Placeholder="Phone" Margin="0,8,0,0" />
                <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.RegistrationEmail}" t:ThemeAssist.Placeholder="Email" Margin="0,8,0,0" />
                <Button Content="Create customer" Style="{StaticResource Button.Secondary}" Command="{Binding Workflow.CreateCustomerCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding Workflow.IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Choose an eligible account type" Style="{StaticResource Text.Subheading}" Margin="0,0,0,14" />
              <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Workflow.EligibleAccountTypes}" SelectedItem="{Binding Workflow.SelectedCreateType}" DisplayMemberPath="Name" t:ThemeAssist.Placeholder="Choose account type" />
              <TextBlock Text="Account types already actively held by the selected customer(s) are filtered out. Fixed-deposit types are shown when their required account is owned." Style="{StaticResource Text.BodyMuted}" Margin="0,8" />
              <TextBlock Text="Owned accounts available for fixed-deposit payout" Style="{StaticResource Text.Title}" Margin="0,18,0,6" />
              <ItemsControl ItemsSource="{Binding Workflow.OwnedAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Workflow.DisplayName}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding Workflow.IsStep4, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Documents and product settings" Style="{StaticResource Text.Subheading}" Margin="0,0,0,14" />
              <TextBlock Text="Choose a file for each required document" Style="{StaticResource Text.Title}" />
              <ItemsControl ItemsSource="{Binding Workflow.RequiredDocumentInputs}" Margin="0,8,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DocumentLabel}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,6" />
                        <Button Grid.Column="1" Content="Choose file" Style="{StaticResource Button.Secondary}" Click="BrowseRequiredDocument_Click" Tag="{Binding}" Visibility="{Binding IsPhoto, Converter={StaticResource BoolToCollapsedVisibility}}" />
                        <Button Grid.Column="1" Content="Choose photo" Style="{StaticResource Button.Secondary}" Click="BrowseRequiredDocument_Click" Tag="{Binding}" Visibility="{Binding IsPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Width="76" Height="76" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0" Visibility="{Binding IsPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,4">
                <StackPanel>
                  <DockPanel>
                    <Button Content="＋ Add referrer" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding Workflow.AddRefererInputCommand}" />
                    <StackPanel>
                      <TextBlock Text="Account referrers" Style="{StaticResource Text.Title}" />
                      <TextBlock Foreground="{StaticResource MutedForegroundBrush}"><Run Text="Minimum required: " /><Run Text="{Binding Workflow.RequiredRefererCount, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Workflow.RefererInputs}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                          <Button Content="Remove" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.Workflow.RemoveRefererInputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                          <TextBox Style="{StaticResource Input.Text}" Text="{Binding Nrc, UpdateSourceTrigger=PropertyChanged}" t:ThemeAssist.Placeholder="Referrer NRC" Margin="0,0,8,0" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Text="Opening balance" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,0" />
              <TextBox Style="{StaticResource Input.Text}" Text="{Binding Workflow.OpeningBalance}" />
              <StackPanel Visibility="{Binding Workflow.IsFixedDeposit, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Interest rate rule" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,0" />
                <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Workflow.InterestRateRules}" SelectedItem="{Binding Workflow.SelectedInterestRateRule}" DisplayMemberPath="DisplayName" />
                <TextBlock Text="Payout account" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,0" />
                <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Workflow.OwnedAccounts}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Workflow.PayoutAccountId}" />
                <TextBlock Text="Renewal instruction" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,0" />
                <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Workflow.RenewalInstructions}" SelectedItem="{Binding Workflow.RenewalInstruction}" />
                <CheckBox Content="Calculate interest from current principal" IsChecked="{Binding Workflow.CalculateFromCurrent}" Margin="0,10,0,0" Style="{StaticResource Input.Check}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding Workflow.IsStep5, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="Review and create" Style="{StaticResource Text.Subheading}" Margin="0,0,0,14" />
              <TextBlock Text="{Binding Workflow.Holder1.FullName}" />
              <TextBlock Text="{Binding Workflow.Holder2.FullName}" />
              <TextBlock Text="{Binding Workflow.SelectedCreateType.Name}" Style="{StaticResource Text.Title}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Workflow.OpeningBalance}" />
              <Button Content="Create account" Style="{StaticResource Button.Primary}" Command="{Binding Workflow.CreateAccountCommand}" Margin="0,16,0,0" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding Workflow.ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,12,0,0" />
            <DockPanel Margin="0,18,0,0">
              <Button Content="Previous step" Style="{StaticResource Button.Ghost}" Command="{Binding Workflow.BackCreateStepCommand}" />
              <Button Content="Continue" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding Workflow.ContinueCreateStepCommand}" Visibility="{Binding Workflow.IsNotStep5, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
