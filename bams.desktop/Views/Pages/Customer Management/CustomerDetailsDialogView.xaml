<UserControl x:Class="bams.desktop.Views.Pages.CustomerDetailsDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:t="clr-namespace:bams.desktop.Themes" xmlns:icon="clr-namespace:bams.desktop.Components.Icon" Width="600">
    <!-- Read-only customer detail card, hosted by ModalDialog. DataContext: CustomerDetailsViewModel. -->
    <StackPanel>
        <!-- Header: icon, full name, badges -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" VerticalAlignment="Top">
                <!-- No photo: plain circle + placeholder icon. -->
                <Ellipse Fill="{StaticResource SecondaryBrush}" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToCollapsedVisibility}}" />
                <icon:Icon Geometry="{StaticResource Icon.Users}" Size="20" StrokeThickness="2" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToCollapsedVisibility}}" />
                <!-- Has photo: the customer's Photo document, filled into the same circle. -->
                <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Customer.FullName}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Customer.CustomerNo}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ContentControl Content="{Binding KycStatusText}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Warning}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KycStatusText}" Value="Verified">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KycStatusText}" Value="Rejected">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ContentControl Content="{Binding RiskLevelText}" Margin="6,0,0,0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Warning}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskLevelText}" Value="Low">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevelText}" Value="High">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ContentControl Content="{Binding StatusText}" Margin="6,0,0,0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Success}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Separator Style="{StaticResource Divider}" Margin="0,20" />
        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ===== Customer information ===== -->
                <TextBlock Text="Customer Information" Style="{StaticResource Text.CardTitle}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CUSTOMER TYPE" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerTypeText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Text="DATE OF BIRTH" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DateOfBirthText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="2" Text="NRC / PASSPORT" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding NrcNumberText}" Style="{StaticResource Text.Mono}" />
                        <TextBlock Text=" / " Style="{StaticResource Text.BodyMuted}" />
                        <TextBlock Text="{Binding PassportNumberText}" Style="{StaticResource Text.Mono}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="NATIONALITY" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NationalityText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="4" Text="PHONE" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PhoneText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="5" Text="EMAIL" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EmailText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="6" Text="OCCUPATION" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OccupationText}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="7" Text="ADDRESS" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AddressText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="8" Text="CREATED" Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource Text.Body}" />
                </Grid>
                <Separator Style="{StaticResource Divider}" Margin="0,20" />
                <!-- ===== Documents ===== -->
                <TextBlock Text="Documents" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="No documents attached." Style="{StaticResource Text.BodyMuted}" Margin="0,8,0,0" Visibility="{Binding HasDocuments, Converter={StaticResource BoolToCollapsedVisibility}}" />
                <ItemsControl ItemsSource="{Binding Documents}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- Attached: a Download button. Not attached: muted text, no button. -->
                                        <Button DockPanel.Dock="Right" Content="Download" Style="{StaticResource Button.Secondary}" t:ThemeAssist.Icon="{StaticResource Icon.Download}" t:ThemeAssist.IsLoading="{Binding IsDownloading}" Command="{Binding DownloadCommand}" Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock DockPanel.Dock="Right" Text="Not attached" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" Visibility="{Binding HasFile, Converter={StaticResource BoolToCollapsedVisibility}}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" FontWeight="Medium" />
                                                <ContentControl Style="{StaticResource Badge.Success}" Content="Verified" Margin="8,0,0,0" Visibility="{Binding IsVerified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Text.BodyMuted}" Margin="0,2,0,0">
                                                <Run Text="{Binding DocumentNumberText, Mode=OneWay}" />
                                                <Run Text=" · Issued " />
                                                <Run Text="{Binding IssuedText, Mode=OneWay}" />
                                                <Run Text=" · Expiry " />
                                                <Run Text="{Binding ExpiryText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Close" Style="{StaticResource Button.Secondary}" MinWidth="96" IsDefault="True" Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>