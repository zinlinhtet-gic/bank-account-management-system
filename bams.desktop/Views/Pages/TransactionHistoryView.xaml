<UserControl x:Class="bams.desktop.Views.Pages.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:b="clr-namespace:bams.desktop.Behaviors"
             xmlns:tx="clr-namespace:bams.desktop.Views.Pages.Transactions">
    <!--
        Transaction History page (auditors, read-only). DataContext: TransactionHistoryViewModel.
        Filter bar (Filter) → error banner → titled transaction table (List). Clicking a row opens the detail card.
    -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Filter bar ===== -->
        <tx:TransactionFilterBar DataContext="{Binding Filter}"/>

        <!-- ===== Error banner ===== -->
        <ContentControl Grid.Row="1" Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ===== Transaction table ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card.Flush}" Margin="0,16,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <tx:TransactionPager DataContext="{Binding List}" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource Button.Icon}"
                                    t:ThemeAssist.Icon="{StaticResource Icon.Refresh}" ToolTip="Refresh list"
                                    t:ThemeAssist.IsLoading="{Binding List.IsLoading}"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Transaction history" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                            <ContentControl Style="{StaticResource Badge.Neutral}" t:ThemeAssist.ShowDot="False"
                                            Content="{Binding List.CountText}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- Row click (or Enter) opens the detail card. -->
                    <DataGrid Style="{StaticResource Table}" BorderThickness="0" Cursor="Hand"
                              ItemsSource="{Binding List.Transactions}"
                              b:DataGridRowClick.Command="{Binding ShowDetailsCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transaction no" Binding="{Binding TransactionNo}" Width="240"
                                                ElementStyle="{StaticResource Table.Text.Code}"/>

                            <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="150"
                                                ElementStyle="{StaticResource Table.Text}"/>

                            <DataGridTemplateColumn Header="Status" Width="125" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource Badge.TransactionStatus}" Content="{Binding StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Amount (MMK)" Binding="{Binding AmountText}" Width="125"
                                                SortMemberPath="Amount" ElementStyle="{StaticResource Table.Text.Mono}"/>

                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceText}" Width="*"
                                                ElementStyle="{StaticResource Table.Text.Muted}"/>

                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionAtText}" Width="175"
                                                SortMemberPath="TransactionAt" ElementStyle="{StaticResource Table.Text.Muted}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state under the column headers -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" IsHitTestVisible="False"
                                Visibility="{Binding List.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="No transactions found" Style="{StaticResource Text.Subheading}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try other filters or clear them with Reset." Style="{StaticResource Text.BodyMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
