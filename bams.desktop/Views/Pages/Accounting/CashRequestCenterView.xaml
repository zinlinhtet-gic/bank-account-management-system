<UserControl x:Class="bams.desktop.Views.Pages.Accounting.CashRequestCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Cash Requests" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Review officers' requests and approve or reject requests awaiting a decision." Style="{StaticResource Text.BodyMuted}" Margin="0,4,0,16" />
            <Border Style="{StaticResource Card.Compact}" Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Width="220" Margin="0,0,10,0">
                        <TextBlock Text="BUSINESS DATE" Style="{StaticResource Text.FieldLabel}" />
                        <DatePicker SelectedDate="{Binding SelectedDate}" Style="{StaticResource Input.Date}" />
                    </StackPanel>
                    <Button Content="Load Requests" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom" />
                </WrapPanel>
            </Border>
            <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />
            <ContentControl Style="{StaticResource Alert.Success}" Content="{Binding SuccessMessage}" Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" />
            <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Requests}"
                      SelectedItem="{Binding SelectedRequest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True" MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Request" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" />
                    <DataGridTextColumn Header="Officer" Binding="{Binding OfficerId}" />
                    <DataGridTextColumn Header="Requested amount" Binding="{Binding RequestedAmount, StringFormat=N2}" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Note}" Width="2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Approved amount" Binding="{Binding ApprovedAmount, StringFormat=N2}" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Style="{StaticResource Card.Compact}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Review selected request" Style="{StaticResource Text.Subheading}" Margin="0,0,0,8" />
                    <TextBlock Text="Enter the approved amount. If the officer left the amount blank, choose an amount here." Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Width="280" Margin="0,0,0,10">
                        <TextBlock Text="APPROVED AMOUNT" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Text="{Binding ApprovedAmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" t:ThemeAssist.Placeholder="Amount" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="Approve and reserve cash" Command="{Binding ApproveCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                        <Button Content="Reject request" Command="{Binding RejectCommand}" Style="{StaticResource Button.Danger}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
