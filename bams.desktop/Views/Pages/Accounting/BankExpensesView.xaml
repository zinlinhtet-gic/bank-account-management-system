<UserControl x:Class="bams.desktop.Views.Pages.Accounting.BankExpensesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Bank Expense Recording" Style="{StaticResource Text.Heading}"/><TextBlock Text="Record operating purchases paid with bank cash. A manager reviews the request before the cash and accounting entries are posted." TextWrapping="Wrap" Margin="0,10"/><Border Style="{StaticResource Card}" Margin="0,12"><StackPanel><TextBlock Text="Cash position" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PositionType}"/><Run Text=" — session "/><Run Text="{Binding Id}"/><Run Text=" — "/><Run Text="{Binding BusinessDate}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Margin="0,7" ><TextBlock Text="Amount" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Payee" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Payee,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Purpose" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Purpose,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Style="{StaticResource Button.Secondary}" Content="Attach receipt (PDF / JPEG / PNG)" Command="{Binding AttachCommand}" HorizontalAlignment="Left" Margin="0,8"/><TextBlock Text="{Binding ReceiptName}"/><StackPanel Margin="0,7" ><TextBlock Text="Missing receipt explanation (required when no receipt is attached)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding MissingReceiptReason,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><WrapPanel Margin="0,12"><Button Content="Submit for approval" Command="{Binding SubmitCommand}" Style="{StaticResource Button.Primary}"/><Button Style="{StaticResource Button.Secondary}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="450"><DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Source date" Binding="{Binding BusinessDate}" Width="*"/><DataGridTextColumn Header="Posting date" Binding="{Binding PostingDate}" Width="*"/><DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="*"/><DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="ReceiptFileName" Binding="{Binding ReceiptFileName}" Width="*"/><DataGridTextColumn Header="MissingReceiptReason" Binding="{Binding MissingReceiptReason}" Width="*"/><DataGridTextColumn Header="TransactionId" Binding="{Binding TransactionId}" Width="*"/><DataGridTemplateColumn Header="Receipt"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource Button.Secondary}" Content="Open receipt" Command="{Binding DataContext.ReceiptCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Review"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Button.Primary}" Content="Accept" Command="{Binding DataContext.AcceptCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Button.Danger}" Content="Reject" Command="{Binding DataContext.RejectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="6,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>

