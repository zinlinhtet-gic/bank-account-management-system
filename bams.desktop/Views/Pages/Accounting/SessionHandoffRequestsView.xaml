<UserControl x:Class="bams.desktop.Views.Pages.Accounting.SessionHandoffRequestsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Session Handoff Requests" Style="{StaticResource Text.Title}"/><TextBlock Text="Only the selected recipient can acknowledge a handover." Style="{StaticResource Text.BodyMuted}" Margin="0,8,0,16"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"/>
<DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Handoffs}" SelectedItem="{Binding SelectedHandoff}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" Margin="0,16"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}"/><DataGridTextColumn Header="Session" Binding="{Binding SessionId}"/><DataGridTextColumn Header="Sender" Binding="{Binding SenderName}" Width="*"/><DataGridTextColumn Header="Recipient" Binding="{Binding RecipientName}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount,StringFormat=N2}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid>
<TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" ToolTip="Acknowledgement, decline or reassignment note"/><WrapPanel Margin="0,12"><Button Content="Acknowledge" Command="{Binding AcceptCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/><Button Content="Decline" Command="{Binding DeclineCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Load History" Command="{Binding LoadHistoryCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel>
<WrapPanel><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" DisplayMemberPath="FullName" Width="260" Margin="0,0,8,0"/><Button Content="Reassign" Command="{Binding ReassignCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12"/><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding History}" AutoGenerateColumns="True" IsReadOnly="True" MinHeight="140"/></StackPanel></ScrollViewer></UserControl>