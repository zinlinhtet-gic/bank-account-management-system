<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconcileProposalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:t="clr-namespace:bams.desktop.Themes" t:RefreshAssist.Command="{Binding PollCommand}"><StackPanel Margin="24"><TextBlock Text="Reconcile proposals" Style="{StaticResource Text.Heading}"/><Button Style="{StaticResource Button.Secondary}" Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,12"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="650"><DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="ExceptionId" Binding="{Binding ExceptionId}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Discrepancy" Binding="{Binding Discrepancy}" Width="*"/><DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="*"/><DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="ProposerId" Binding="{Binding ProposerId}" Width="*"/><DataGridTemplateColumn Header="Review"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Button.Secondary}" Content="Receipt" Command="{Binding DataContext.ReceiptCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="3"/><Button Style="{StaticResource Button.Primary}" Content="Accept" Command="{Binding DataContext.AcceptCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="3"/><Button Style="{StaticResource Button.Danger}" Content="Reject" Command="{Binding DataContext.RejectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="3"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/></StackPanel></UserControl>

