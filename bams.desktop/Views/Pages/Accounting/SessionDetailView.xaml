<UserControl x:Class="bams.desktop.Views.Pages.Accounting.SessionDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:bams.desktop.Views.Pages.Accounting"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><WrapPanel Margin="0,0,0,16"><Button Content="Back to Sessions" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Recount closed session" Command="{Binding RecountCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel>
<TextBlock Text="Session Detail" Style="{StaticResource Text.Title}"/><Border Style="{StaticResource Card}" Margin="0,16"><StackPanel>
<TextBlock Text="{Binding Session.Id,StringFormat=Session #{0}}" Style="{StaticResource Text.Heading}"/><TextBlock Text="{Binding Session.OfficerName}"/><TextBlock Text="{Binding Session.BusinessDate,StringFormat=Business date: {0:yyyy-MM-dd}}"/><TextBlock Text="{Binding Session.Status,StringFormat=Status: {0}}"/>
<TextBlock Text="{Binding Session.OpeningCash,StringFormat=Opening cash: {0:N2}}"/><TextBlock Text="{Binding Session.ExpectedClosingCash,StringFormat=Expected cash: {0:N2}}"/><TextBlock Text="{Binding Session.ActivatedAtUtc,StringFormat=Activated (UTC): {0}}"/><TextBlock Text="{Binding Session.ClosedAtUtc,StringFormat=Closed (UTC): {0}}"/>
</StackPanel></Border><TextBlock Text="{Binding Message}" Style="{StaticResource Text.Error}"/>
<TabControl><TabItem Header="Transactions"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Transactions}" IsReadOnly="True" AutoGenerateColumns="True" MinHeight="260"/></TabItem>
<TabItem Header="Cash Movements"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Movements}" IsReadOnly="True" AutoGenerateColumns="True" MinHeight="260"/></TabItem>
<TabItem Header="Counts"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Counts}" IsReadOnly="True" AutoGenerateColumns="True" MinHeight="260"/></TabItem>
<TabItem Header="Cash Requests"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Requests}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260"><DataGrid.Columns>
<DataGridTextColumn Header="Request" Binding="{Binding Id}"/><DataGridTextColumn Header="Reason" Binding="{Binding Note}" Width="*"/><DataGridTextColumn Header="Requested" Binding="{Binding RequestedAmount,StringFormat=N2}"/><DataGridTextColumn Header="Approved" Binding="{Binding ApprovedAmount,StringFormat=N2}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
<DataGridTemplateColumn Header="Receipt"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsOwner,RelativeSource={RelativeSource AncestorType=DataGrid},Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="Accept" Command="{Binding DataContext.AcceptCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Reject" Command="{Binding DataContext.RejectCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid></TabItem></TabControl></StackPanel></ScrollViewer></UserControl>