<UserControl x:Class="bams.desktop.Views.Pages.Accounting.BusinessDateOpeningView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:bams.desktop.Views.Pages.Accounting"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Business Date Opening" Style="{StaticResource Text.Title}"/>
<TextBlock Text="{Binding Step,StringFormat=Step {0} of 3}" Style="{StaticResource Text.Heading}" Margin="0,12,0,0"/><TextBlock Text="1. Business Date and Vault  &#x2192;  2. Officer Sessions  &#x2192;  3. Review and Submit" Style="{StaticResource Text.Subheading}" Margin="0,16"/>
<TextBlock Text="{Binding BusinessDateSummary}" Style="{StaticResource Text.BodyMuted}"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,16"/>
<StackPanel Visibility="{Binding ShowStartForm,Converter={StaticResource BooleanToVisibilityConverter}}">
<Border Style="{StaticResource Card}" Visibility="{Binding IsStepOne,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
<TextBlock Text="TODAY (MYANMAR)" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Text.Heading}" Margin="0,8,0,16"/>
<TextBlock Text="INITIAL VAULT CASH" Style="{StaticResource Text.FieldLabel}"/><TextBox Text="{Binding StartingCashText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" Width="280" HorizontalAlignment="Left"/>
</StackPanel></Border>
<ContentControl Visibility="{Binding IsStepTwo,Converter={StaticResource BooleanToVisibilityConverter}}"><local:SessionScheduleEditorView DataContext="{Binding Editor}"/></ContentControl>
<Border Style="{StaticResource Card}" Visibility="{Binding IsStepThree,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Review opening" Style="{StaticResource Text.Heading}"/><TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" Margin="0,12"/><DataGrid ItemsSource="{Binding Editor.Rows}" Style="{StaticResource Table}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" Margin="0,12"><DataGrid.Columns><DataGridTextColumn Header="Officer" Binding="{Binding Officer.FullName}" Width="*"/><DataGridTextColumn Header="Start" Binding="{Binding Start}"/><DataGridTextColumn Header="End" Binding="{Binding End}"/><DataGridTextColumn Header="Starting cash" Binding="{Binding Cash}"/></DataGrid.Columns></DataGrid><TextBlock Text="Opening today deactivates other active dates. All schedules and cash reservations are submitted together." TextWrapping="Wrap"/></StackPanel></Border>
<WrapPanel Margin="0,16"><Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/><Button Content="Open Business Date" Command="{Binding StartBusinessDateCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding IsStepThree,Converter={StaticResource BooleanToVisibilityConverter}}"/></WrapPanel>
</StackPanel><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/><TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>