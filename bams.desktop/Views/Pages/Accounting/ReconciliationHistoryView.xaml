<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconciliationHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Reconciliation history" Style="{StaticResource Text.Heading}" FontSize="28" Margin="0,0,0,16"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Proposal" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Exception" Binding="{Binding ExceptionId}" Width="*"/><DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="*"/><DataGridTextColumn Header="Discrepancy" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="*"/><DataGridTextColumn Header="Proposer" Binding="{Binding ProposerId}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="{Binding SelectedProposal.Inputs.Findings}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProposal.Inputs.EvidenceReference}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProposal.ReviewNote}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProposal.VerificationNote}" TextWrapping="Wrap"/><TextBlock Text="{Binding Preview.Explanation}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="{Binding Preview.SuggestedAmount, StringFormat='Suggested amount: {0:N2}'}" FontWeight="Bold"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Lines}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Ledger" Binding="{Binding Ledger}" Width="*"/><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerAccountId}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="*"/></DataGrid.Columns></DataGrid></Border><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Balances}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid></Border><Button Content="Load exception timeline" Command="{Binding TimelineCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Timeline.Timeline}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding CreatedAtUtc}" Width="*"/><DataGridTextColumn Header="From" Binding="{Binding OldStatus}" Width="*"/><DataGridTextColumn Header="To" Binding="{Binding NewStatus}" Width="*"/><DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Working..." Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></ScrollViewer></UserControl>
