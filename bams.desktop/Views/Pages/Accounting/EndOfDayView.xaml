<UserControl x:Class="bams.desktop.Views.Pages.Accounting.EndOfDayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounting="clr-namespace:bams.desktop.Views.Pages.Accounting">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="End of Day" Style="{StaticResource Text.Title}"/>
            <Border Style="{StaticResource Card.Compact}" Margin="0,16,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="BUSINESS DATE" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBlock Text="{Binding Summary.BusinessDate.Date}" Style="{StaticResource Text.Heading}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Run Pre-Close Checks" Command="{Binding RunPreCloseCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                        <Button Content="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                        <Button Content="Close Business Date" Command="{Binding CloseCommand}" Style="{StaticResource Button.Primary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TabControl MinHeight="520">
                <TabItem Header="Summary">
                    <StackPanel Margin="12">
                        <TextBlock Text="Current Close Status" Style="{StaticResource Text.Subheading}"/>
                        <DataGrid ItemsSource="{Binding PreCloseChecks.Stages}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" Margin="0,8,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="160"/>
                                <DataGridTextColumn Header="Issues" Binding="{Binding IssueCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding ExceptionCenter.UnresolvedCount, StringFormat=Outstanding issues: {0}}" Style="{StaticResource Text.BodyMuted}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Pre-Close Checks">
                    <DataGrid ItemsSource="{Binding PreCloseChecks.Stages}" AutoGenerateColumns="False" IsReadOnly="True" Margin="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="160"/>
                            <DataGridTextColumn Header="Issues" Binding="{Binding IssueCount}" Width="100"/>
                            <DataGridTextColumn Header="Message Code" Binding="{Binding MessageCode}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Cash Reconciliation">
                    <accounting:CashReconciliationView DataContext="{Binding CashReconciliation}"/>
                </TabItem>
                <TabItem Header="Ledger Reconciliation">
                    <StackPanel Margin="12">
                        <TextBlock Text="Daily ledger debit and credit totals are checked during pre-close and again before close." TextWrapping="Wrap" Style="{StaticResource Text.Body}"/>
                        <TextBlock Text="{Binding LedgerReconciliation.Status, StringFormat=Ledger status: {0}}" Style="{StaticResource Text.Subheading}" Margin="0,12,0,0"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Account Reconciliation">
                    <accounting:ReconciliationView DataContext="{Binding AccountReconciliation.Results}"/>
                </TabItem>
                <TabItem Header="Exceptions">
                    <accounting:ExceptionCenterView DataContext="{Binding ExceptionCenter.Investigation}"/>
                </TabItem>
                <TabItem Header="Final Review">
                    <StackPanel Margin="12">
                        <TextBlock Text="Final Review" Style="{StaticResource Text.Subheading}"/>
                        <TextBlock Text="{Binding FinalReview.Run.Status, StringFormat=Run status: {0}}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding FinalReview.Run.PreparedBy, StringFormat=Prepared by user: {0}}" Style="{StaticResource Text.BodyMuted}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding FinalReview.Run.ApprovedBy, StringFormat=Approved by user: {0}}" Style="{StaticResource Text.BodyMuted}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding FinalReview.Run.ClosedBy, StringFormat=Closed by user: {0}}" Style="{StaticResource Text.BodyMuted}" Margin="0,4,0,0"/>
                        <DataGrid ItemsSource="{Binding PreCloseChecks.Stages}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Area" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="160"/>
                                <DataGridTextColumn Header="Outstanding" Binding="{Binding IssueCount}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
