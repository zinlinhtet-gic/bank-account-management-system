<UserControl x:Class="bams.desktop.Views.Pages.Accounting.EndOfDayView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:accounting="clr-namespace:bams.desktop.Views.Pages.Accounting">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="End of Day" Style="{StaticResource Text.Title}"/>
  <WrapPanel Margin="0,14"><DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding SelectedBusinessDate}" Width="165"/>
   <Button Style="{StaticResource Button.Secondary}" Content="Load date" Command="{Binding LoadBusinessDateCommand}" Margin="8,0"/>
   <TextBlock Text="{Binding BusinessDateStatus}" VerticalAlignment="Center" Margin="8,0"/>
   <Button Content="Run checks" Command="{Binding RunPreCloseCommand}" Style="{StaticResource Button.Primary}" Margin="8,0"/>
   <Button Style="{StaticResource Button.Secondary}" Content="Manager recheck" Command="{Binding ReviewPreCloseCommand}" Margin="8,0"/>
  </WrapPanel>
  <accounting:UnifiedReconciliationView DataContext="{Binding Reconciliation}"/>
  <Border Style="{StaticResource Card}" Margin="0,12"><StackPanel>
   <TextBlock Text="Final vault cash validation" Style="{StaticResource Text.Subheading}"/>
   <TextBlock Text="Count the vault after all teller handoffs and pending cash operations are complete." TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="Physical cash amount"/><TextBox Text="{Binding VaultActual,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
   <TextBlock Text="Count notes" Margin="0,8,0,0"/><TextBox Text="{Binding VaultNote,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
   <Button Style="{StaticResource Button.Primary}" Content="Record final vault count" Command="{Binding FinalVaultCountCommand}" HorizontalAlignment="Left" Margin="0,12" Visibility="{Binding HasEndOfDayApprovalPermission,Converter={StaticResource BooleanToVisibilityConverter}}"/>
  </StackPanel></Border>
  <TextBlock Text="{Binding CurrentRunStatus,StringFormat='Closing status: {0}'}" FontWeight="Bold"/>
  <ItemsControl ItemsSource="{Binding PreCloseChecks.Stages}"><ItemsControl.ItemTemplate><DataTemplate><WrapPanel Margin="0,4">
   <TextBlock Text="{Binding Name}" Margin="0,0,12,0"/><TextBlock Text="{Binding Status}" Margin="0,0,12,0"/><TextBlock Text="{Binding IssueCount,StringFormat='Issues: {0}'}"/>
  </WrapPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <WrapPanel Margin="0,14"><Button Style="{StaticResource Button.Primary}" Content="Approve" Command="{Binding ApproveCommand}" Margin="0,0,8,0"/>
   <Button Content="Close date" Command="{Binding CloseCommand}" Style="{StaticResource Button.Primary}"/>
  </WrapPanel>
  <Border Style="{StaticResource Card}" Visibility="{Binding HasEndOfDayApprovalPermission,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
   <TextBlock Text="Force close request" Style="{StaticResource Text.Subheading}"/>
   <TextBlock Text="The request and manager approvals are recorded. Unresolved reconciliation proposals still require resolution." TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding OverrideApprovalStatus}" TextWrapping="Wrap"/>
   <TextBox Style="{StaticResource Input.Text}" Text="{Binding ForceCloseReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"/>
   <WrapPanel Margin="0,12"><Button Style="{StaticResource Button.Danger}" Content="Request force close" Command="{Binding RequestForceCloseCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource Button.Primary}" Content="Approve force close" Command="{Binding ApproveForceCloseCommand}"/>
   </WrapPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/>
  <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>


