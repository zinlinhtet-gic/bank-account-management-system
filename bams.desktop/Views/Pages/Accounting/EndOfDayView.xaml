<UserControl x:Class="bams.desktop.Views.Pages.Accounting.EndOfDayView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:accounting="clr-namespace:bams.desktop.Views.Pages.Accounting" xmlns:t="clr-namespace:bams.desktop.Themes" t:RefreshAssist.Command="{Binding PollCommand}">
 <UserControl.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="End of Day" Style="{StaticResource Text.Heading}"/>
  <TextBlock Text="Reconcile, validate vault cash, obtain approval, and close the business date." Style="{StaticResource Text.BodyMuted}" Margin="0,6"/>
  <WrapPanel Margin="0,12"><DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding SelectedBusinessDate}" Width="165"/>
   <Button Style="{StaticResource Button.Secondary}" Content="Load date / Refresh" Command="{Binding LoadBusinessDateCommand}" Margin="8,0"/>
   <TextBlock Text="{Binding BusinessDateStatus}" VerticalAlignment="Center" Margin="8,0"/>
   <TextBlock Text="{Binding CurrentRunStatus,StringFormat='Closing status: {0}'}" VerticalAlignment="Center" Margin="8,0"/>
  </WrapPanel>
  <Border Style="{StaticResource Card.Compact}" Margin="0,8,0,16"><UniformGrid Columns="5"><Button Content="1. Run checks" Command="{Binding NavigateToStageCommand}" CommandParameter="0" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Style.Triggers><DataTrigger Binding="{Binding IsStep1}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="2. Vault cash" Command="{Binding NavigateToStageCommand}" CommandParameter="1" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Style.Triggers><DataTrigger Binding="{Binding IsStep2}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="3. Readiness" Command="{Binding NavigateToStageCommand}" CommandParameter="2" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Style.Triggers><DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="4. Approval" Command="{Binding NavigateToStageCommand}" CommandParameter="3" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Style.Triggers><DataTrigger Binding="{Binding IsStep4}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="5. Close date" Command="{Binding NavigateToStageCommand}" CommandParameter="4" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Style.Triggers><DataTrigger Binding="{Binding IsStep5}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></UniformGrid></Border>
  <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Subheading}" Margin="0,0,0,12"/>
  <StackPanel Visibility="{Binding IsStep1,Converter={StaticResource BooleanToVisibilityConverter}}">
   <TextBlock Text="Run the shared account/GL and cash check. Assign and investigate exceptions using the action buttons below." Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap"/>
   <Button Content="Run reconciliation checks" Command="{Binding RunPreCloseCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12"/>
   <accounting:UnifiedReconciliationView DataContext="{Binding Reconciliation}"/>
  </StackPanel>
  <Border Style="{StaticResource Card}" Visibility="{Binding IsStep2,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
   <TextBlock Text="Final vault cash validation" Style="{StaticResource Text.Subheading}"/>
   <TextBlock Text="Count the vault after teller sessions are closed, handoffs accepted, and pending cash operations settled. Recording this count closes the vault session; a mismatch remains an exception." Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding VaultStatus}"/>
   <TextBlock Text="{Binding VaultExpected,StringFormat='Expected cash: {0:N2}'}" Margin="0,8"/>
   <TextBlock Text="{Binding VaultCounted,StringFormat='Latest physical count: {0:N2}'}"/>
   <TextBlock Text="{Binding VaultDifference,StringFormat='Difference: {0:N2}'}" Margin="0,6"/>
   <TextBlock Text="Physical cash amount" Style="{StaticResource Text.FieldLabel}"/><TextBox Text="{Binding VaultActual,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
   <TextBlock Text="Count notes" Style="{StaticResource Text.FieldLabel}" Margin="0,8,0,0"/><TextBox Text="{Binding VaultNote,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
   <Button Content="Record final count and close vault" Command="{Binding FinalVaultCountCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12"/>
  </StackPanel></Border>
  <StackPanel Visibility="{Binding IsStep3,Converter={StaticResource BooleanToVisibilityConverter}}">
   <TextBlock Text="Rerun readiness checks after vault validation and after corrections have passed verification. Every blocker must be cleared for normal close." TextWrapping="Wrap" Style="{StaticResource Text.BodyMuted}"/>
   <Button Content="Refresh readiness checks" Command="{Binding RunPreCloseCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12"/>
   <Border Style="{StaticResource Card.Flush}"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding PreCloseChecks.Stages}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="480"><DataGrid.Columns>
    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Issues" Binding="{Binding IssueCount}" Width="*"/><DataGridTextColumn Header="Details" Binding="{Binding MessageCode}" Width="3*"/>
   </DataGrid.Columns></DataGrid></Border>
   <TextBlock Text="{Binding TotalIssueCount,StringFormat='Outstanding issues: {0}'}" Margin="0,12"/>
  </StackPanel>
  <Border Style="{StaticResource Card}" Visibility="{Binding IsStep4,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
   <TextBlock Text="Manager review and approval" Style="{StaticResource Text.Subheading}"/>
   <TextBlock Text="A manager rechecks the prepared run, then approves it. Independent approval is required unless the preparer is the sole eligible manager." Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding FinalReview.Run.PreparedBy,StringFormat='Prepared by user #{0}'}"/>
   <TextBlock Text="{Binding FinalReview.Run.ReviewedBy,StringFormat='Reviewed by user #{0}'}"/>
   <TextBlock Text="{Binding FinalReview.Run.ApprovedBy,StringFormat='Approved by user #{0}'}"/>
   <WrapPanel Margin="0,12"><Button Content="Manager recheck" Command="{Binding ReviewPreCloseCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Approve normal close" Command="{Binding ApproveCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel>
   <TextBlock Text="{Binding OverrideApprovalStatus}" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Visibility="{Binding IsStep5,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
   <TextBlock Text="Close business date" Style="{StaticResource Text.Subheading}"/>
   <TextBlock Text="Closing reruns the required checks, creates the EOD audit and final summaries, then marks this date closed and inactive. Unresolved blockers prevent normal closure." Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,8"/>
   <Button Content="Close date" Command="{Binding CloseCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12"/>
   <TextBlock Text="Business date closed. Audit and final summaries are saved. Any force-close investigations remain available for resolution." TextWrapping="Wrap" Visibility="{Binding IsDateClosed,Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <TextBlock Text="Persisted EOD audit findings" Style="{StaticResource Text.Subheading}" Margin="0,18,0,8"/>
   <Button Content="Refresh audit findings" Command="{Binding AuditCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"/>
   <TextBlock Text="{Binding AuditReport.Status,StringFormat='Audit status: {0}'}" Margin="0,8"/>
   <WrapPanel><TextBlock Text="{Binding AuditReport.RawDebit,StringFormat='Raw debit: {0:N2}'}" Margin="0,0,16,0"/><TextBlock Text="{Binding AuditReport.RawCredit,StringFormat='Raw credit: {0:N2}'}"/></WrapPanel>
   <WrapPanel Margin="0,6"><TextBlock Text="{Binding AuditReport.EffectiveDebit,StringFormat='Effective debit: {0:N2}'}" Margin="0,0,16,0"/><TextBlock Text="{Binding AuditReport.EffectiveCredit,StringFormat='Effective credit: {0:N2}'}"/><TextBlock Text="{Binding AuditReport.IsReconciled,StringFormat=' ? Reconciled: {0}'}"/></WrapPanel>
   <Border Style="{StaticResource Card.Flush}" Margin="0,8"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding AuditReport.Findings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320"><DataGrid.Columns>
    <DataGridTextColumn Header="Finding" Binding="{Binding Kind}" Width="2*"/><DataGridTextColumn Header="Source ID" Binding="{Binding SourceId}" Width="*"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="*"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="*"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*"/>
   </DataGrid.Columns></DataGrid></Border>
  </StackPanel></Border>
  <WrapPanel Margin="0,16"><Button Content="Previous" Command="{Binding PreviousStepCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Next step" Command="{Binding NextStepCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel>
  <Border Style="{StaticResource Card}" Margin="0,8" Visibility="{Binding HasEndOfDayApprovalPermission,Converter={StaticResource BooleanToVisibilityConverter}}"><Expander Header="Force close ? available even when normal close is blocked"><StackPanel Margin="0,12,0,0">
   <TextBlock Text="Bypasses every readiness blocker, including cash validation, unresolved proposals and accounting inequalities. All required managers must approve. The final approval closes the date automatically; investigations remain open." TextWrapping="Wrap" Style="{StaticResource Text.BodyMuted}"/>
   <TextBlock Text="{Binding OverrideApprovalStatus}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="Reason for force close (5?1000 characters)" Style="{StaticResource Text.FieldLabel}"/>
   <TextBox Style="{StaticResource Input.Text}" Text="{Binding ForceCloseReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"/>
   <WrapPanel Margin="0,12"><Button Content="Request force close" Command="{Binding RequestForceCloseCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,8,0"/><Button Content="Approve force close" Command="{Binding ApproveForceCloseCommand}" Style="{StaticResource Button.Danger}"/></WrapPanel>
  </StackPanel></Expander></Border>
  <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/>
  <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
