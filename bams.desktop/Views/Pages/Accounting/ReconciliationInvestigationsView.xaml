<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconciliationInvestigationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Investigations" Style="{StaticResource Text.Heading}" FontSize="28" Margin="0,0,0,16"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Exceptions}" SelectedItem="{Binding SelectedException}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" Width="*"/><DataGridTextColumn Header="Condition" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Assigned" Binding="{Binding AssignedTo}" Width="*"/><DataGridTextColumn Header="Detected" Binding="{Binding CreatedAtUtc}" Width="*"/></DataGrid.Columns></DataGrid></Border><StackPanel IsEnabled="{Binding CanInvestigate}"><TextBlock Text="Discrepancy"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name"/><TextBlock Text="Investigation findings" Margin="0,12,0,4"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Findings,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"/><TextBlock Text="Review due date" Margin="0,12,0,4"/><DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding ReviewDueDate}"/><WrapPanel><Button Content="Save findings" Command="{Binding SaveCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><Button Content="Prepare proposal" Command="{Binding PrepareCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/></WrapPanel></StackPanel><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Working..." Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></ScrollViewer></UserControl>
