<UserControl x:Class="bams.desktop.Views.Pages.Accounting.CashProposalEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="900"><TextBlock Text="Perform cash reconciliation" Style="{StaticResource Text.Heading}"/><Border Style="{StaticResource Card.Compact}" Margin="0,18"><UniformGrid Columns="3"><TextBlock Text="1. Choose discrepancy"/><TextBlock Text="2. Required fields"/><TextBlock Text="3. Send proposal"/></UniformGrid></Border><StackPanel Visibility="{Binding IsStep1,Converter={StaticResource BooleanToVisibilityConverter}}"><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name"/></StackPanel><StackPanel Visibility="{Binding IsStep2,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="0,7" Visibility="{Binding NeedsAccount,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Customer account ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding AccountId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" Visibility="{Binding NeedsTransaction,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Posted transaction ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding TransactionId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" Visibility="{Binding NeedsMovement,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Original cash movement ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding MovementId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" Visibility="{Binding NeedsDestination,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Correct / destination cash session ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding DestinationId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Amount (for a count error enter the actual counted cash)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Investigation findings" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Findings,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Evidence reference" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Evidence,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Visibility="{Binding NeedsExpense,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="0,7" ><TextBlock Text="Payee" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Payee,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,7" ><TextBlock Text="Bank operating purpose" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Purpose,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Style="{StaticResource Button.Secondary}" Content="Attach receipt (PDF / JPEG / PNG)" Command="{Binding AttachCommand}" HorizontalAlignment="Left" Margin="0,8"/><TextBlock Text="{Binding ReceiptName}"/><StackPanel Margin="0,7" ><TextBlock Text="Missing receipt explanation (required when no receipt is attached)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding MissingReceiptReason,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></StackPanel></StackPanel><StackPanel Visibility="{Binding IsStep3,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding SelectedKind.Name}" FontWeight="Bold"/><TextBlock Text="{Binding Findings}" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="{Binding Preview.Explanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Preview.SuggestedAmount,StringFormat='Suggested amount: {0:N2}'}" Margin="0,12"/><TextBlock Text="{Binding Preview.CashChange,StringFormat='Cash position change: {0:N2}'}"/><Button Content="Send proposal" Command="{Binding SubmitCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,15"/></StackPanel><WrapPanel Margin="0,16"><Button Style="{StaticResource Button.Secondary}" Content="Previous" Command="{Binding PreviousCommand}" Margin="0,0,8,0"/><Button Content="Continue / Preview" Command="{Binding ContinueCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Primary}"><Style.Triggers><DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></UserControl>
