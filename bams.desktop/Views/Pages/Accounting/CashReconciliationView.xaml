<UserControl x:Class="bams.desktop.Views.Pages.Accounting.CashReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Teller and Vault Cash" Style="{StaticResource Text.Title}" />
            <WrapPanel Margin="0,16,0,12">
                <StackPanel Margin="0,0,12,0"><TextBlock Text="BRANCH ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="130" Text="{Binding BranchIdText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding BranchIdError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="180"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="POSITION" Style="{StaticResource Text.FieldLabel}"/><ComboBox Width="130" ItemsSource="{Binding PositionTypes}" SelectedItem="{Binding PositionType}"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="OPENING CASH" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="150" Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding OpeningCashError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="190"/></StackPanel>
                <Button Content="Open Session" Command="{Binding OpenSessionCommand}" Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Session" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchId}"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding PositionType}"/>
                    <DataGridTextColumn Header="Teller" Binding="{Binding TellerId}"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}"/>
                    <DataGridTextColumn Header="Opening" Binding="{Binding OpeningCash, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedClosingCash, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="View Selected Session History" Command="{Binding ViewSessionHistoryCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <TextBlock Text="Session movement and count history" Style="{StaticResource Text.Subheading}" Margin="0,14,0,6"/>
            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="110">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding CreatedAtUtc}" Width="170"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationSessionId}" Width="100"/>
                    <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionId}" Width="100"/>
                    <DataGridTextColumn Header="Correction" Binding="{Binding CorrectionTransactionId}" Width="100"/>
                    <DataGridTextColumn Header="Actor" Binding="{Binding ActorId}" Width="80"/>
                    <DataGridTextColumn Header="Approved By" Binding="{Binding ApprovedBy}" Width="100"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid ItemsSource="{Binding Counts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Counted (UTC)" Binding="{Binding CountedAtUtc}" Width="170"/>
                    <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedAmount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Actual" Binding="{Binding ActualAmount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Counted By" Binding="{Binding CountedBy}" Width="100"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,16,0,0">
                <StackPanel Margin="0,0,12,0"><TextBlock Text="SESSION ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="130" Text="{Binding SelectedSessionIdText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding SessionIdError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="180"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="PHYSICAL COUNT" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="150" Text="{Binding ActualCashText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding ActualCashError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="200"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="COUNT NOTES (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="220" Text="{Binding CountNotes, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding CountNotesError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="240"/></StackPanel>
                <Button Content="Submit Count and Close" Command="{Binding CountCashCommand}" Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <WrapPanel Margin="0,12,0,0">
                <StackPanel Margin="0,0,12,0"><TextBlock Text="DESTINATION SESSION ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="190" Text="{Binding DestinationSessionIdText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding DestinationSessionIdError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="220"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="TRANSFER AMOUNT" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="150" Text="{Binding TransferAmountText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding TransferAmountError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="200"/></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="TRANSFER NOTE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="220" Text="{Binding TransferNote, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding TransferNoteError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="240"/></StackPanel>
                <Button Content="Transfer Cash" Command="{Binding TransferCashCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <Border Style="{StaticResource Card.Compact}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Approved cash adjustment request" Style="{StaticResource Text.Subheading}"/>
                    <TextBlock Text="A signed amount must exactly match the linked posted transaction's Cash on Hand journal effect. A separate authorized user approves it." TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="SIGNED CASH EFFECT" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="160" Text="{Binding AdjustmentAmountText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding AdjustmentAmountError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="210"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="CORRECTION TRANSACTION ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="190" Text="{Binding CorrectionTransactionIdText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding CorrectionTransactionIdError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="230"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="NOTE" Style="{StaticResource Text.FieldLabel}"/><TextBox Width="220" Text="{Binding AdjustmentNote, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding AdjustmentNoteError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="240"/></StackPanel>
                        <Button Content="Submit for Approval" Command="{Binding RequestAdjustmentCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Adjustments}" SelectedItem="{Binding SelectedAdjustment}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Request" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Session" Binding="{Binding SessionId}"/>
                            <DataGridTextColumn Header="Signed Effect" Binding="{Binding SignedAmount, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Correction Txn" Binding="{Binding CorrectionTransactionId}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Approve Selected Adjustment" Command="{Binding ApproveAdjustmentCommand}" IsEnabled="{Binding CanApproveAdjustments}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
