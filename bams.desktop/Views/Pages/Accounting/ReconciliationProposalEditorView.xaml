<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconciliationProposalEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Prepare correction proposal" Style="{StaticResource Text.Heading}" FontSize="28" Margin="0,0,0,16"/><Button Content="Back to assigned tasks" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><TextBlock Text="{Binding ContextLabel}" FontWeight="Bold"/>
<Border Style="{StaticResource Card.Compact}" Margin="0,10"><UniformGrid Columns="3"><TextBlock Text="1. Choose discrepancy"/><TextBlock Text="2. Required fields"/><TextBlock Text="3. Send proposal"/></UniformGrid></Border><TextBlock Text="{Binding StepLabel}" Margin="0,6"/>
<StackPanel IsEnabled="{Binding CanEdit}">
<StackPanel Visibility="{Binding IsStep1,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="0,8" ><TextBlock Text="Discrepancy" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name"/></StackPanel></StackPanel>
<StackPanel Visibility="{Binding IsStep2,Converter={StaticResource BooleanToVisibilityConverter}}">
<StackPanel Margin="0,8" ><TextBlock Text="Affected transaction ID" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding TransactionIdText,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Content="Load transaction evidence" Command="{Binding LoadEvidenceCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/>
<StackPanel Margin="0,8" Visibility="{Binding NeedsAccountEntry, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Incorrect customer entry (leave empty if customer postings are correct)" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding AccountEntries}" SelectedItem="{Binding AccountEntry}" DisplayMemberPath="Label"/></StackPanel>
<StackPanel Margin="0,8" Visibility="{Binding NeedsGlEntry, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Incorrect GL entry (leave empty if GL postings are correct)" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding JournalEntries}" SelectedItem="{Binding GlEntry}" DisplayMemberPath="Label"/></StackPanel>
<StackPanel Margin="0,8" Visibility="{Binding NeedsCorrectGl, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Correct GL account" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding GlAccounts}" SelectedItem="{Binding CorrectGl}" DisplayMemberPath="Name"/></StackPanel>
<StackPanel Margin="0,8" Visibility="{Binding NeedsOffsetGl, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Balancing GL account" Style="{StaticResource Text.FieldLabel}"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding GlAccounts}" SelectedItem="{Binding OffsetGl}" DisplayMemberPath="Name"/></StackPanel>
<StackPanel Visibility="{Binding NeedsCorrectAccount,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="0,8" ><TextBlock Text="Find correct customer account" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding AccountSearch,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Content="Search accounts" Command="{Binding SearchAccountCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding CorrectAccount}" DisplayMemberPath="DisplayName"/></StackPanel>
<StackPanel Margin="0,8" Visibility="{Binding NeedsPostingDate, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Correct posting date" Style="{StaticResource Text.FieldLabel}"/><DatePicker Style="{StaticResource Input.Date}" SelectedDate="{Binding CorrectPostingDate}"/></StackPanel>
<StackPanel Margin="0,8" ><TextBlock Text="Investigation findings" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding Findings,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"/></StackPanel>
<StackPanel Margin="0,8" ><TextBlock Text="Supporting evidence reference" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding EvidenceReference,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
<StackPanel Margin="0,8" ><TextBlock Text="External recovery reference (settled external transfers)" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding ExternalRecoveryReference,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
</StackPanel>
<StackPanel Visibility="{Binding IsStep2,Converter={StaticResource BooleanToVisibilityConverter}}">
<StackPanel Margin="0,8" Visibility="{Binding NeedsAmount, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Correct amount established by investigation" Style="{StaticResource Text.FieldLabel}"/><TextBox Style="{StaticResource Input.Text}" Text="{Binding CorrectAmount,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
<Button Content="Calculate suggested correction" Command="{Binding PreviewCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><TextBlock Text="{Binding Preview.Explanation}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="{Binding Preview.SuggestedAmount, StringFormat='Suggested amount: {0:N2}'}" FontWeight="Bold"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Lines}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Ledger" Binding="{Binding Ledger}" Width="*"/><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerAccountId}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="*"/></DataGrid.Columns></DataGrid></Border><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Balances}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid></Border></StackPanel></StackPanel>
<StackPanel Visibility="{Binding IsStep3,Converter={StaticResource BooleanToVisibilityConverter}}">
<TextBlock Text="{Binding SelectedKind.Name}" Style="{StaticResource Text.Subheading}"/><TextBlock Text="{Binding Findings}" TextWrapping="Wrap"/><TextBlock Text="{Binding EvidenceReference}" TextWrapping="Wrap"/><TextBlock Text="{Binding Preview.Explanation}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="{Binding Preview.SuggestedAmount, StringFormat='Suggested amount: {0:N2}'}" FontWeight="Bold"/><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Lines}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Ledger" Binding="{Binding Ledger}" Width="*"/><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerAccountId}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="*"/></DataGrid.Columns></DataGrid></Border><Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Preview.Balances}"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="140" MaxHeight="300" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid></Border>
<Button Content="Submit proposal" Command="{Binding SubmitCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/></StackPanel>
<WrapPanel><Button Content="Save draft" Command="{Binding SaveDraftCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><Button Content="Previous step" Command="{Binding PreviousCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,8,8"/><Button Content="Continue" Command="{Binding ContinueCommand}" Visibility="{Binding IsNotLastStep,Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource Button.Primary}" Margin="0,8"/></WrapPanel><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Working..." Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></ScrollViewer></UserControl>

