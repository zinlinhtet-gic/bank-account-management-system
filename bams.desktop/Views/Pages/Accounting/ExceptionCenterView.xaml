<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ExceptionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Reconciliation Exceptions" Style="{StaticResource Text.Subheading}"/>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshExceptionsCommand}" Style="{StaticResource Button.Secondary}"/>
            </DockPanel>
            <Border Style="{StaticResource Card.Flush}">
            <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}"><TextBlock Text="Exception register" Style="{StaticResource Text.FieldLabel}"/></Border>
            <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Exceptions}" SelectedItem="{Binding SelectedException}" MinHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Type / Source" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}"/>
                    <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedAmount, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Actual" Binding="{Binding ActualAmount, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="Assigned" Binding="{Binding AssignedTo}"/>
                    <DataGridTextColumn Header="Related Txn" Binding="{Binding RelatedTransactionId}"/>
                    <DataGridTextColumn Header="Correction Txn" Binding="{Binding CorrectionTransactionId}"/>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
            </Border>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Load audit timeline" Command="{Binding LoadExceptionTimelineCommand}" Style="{StaticResource Button.Secondary}"/>
                <ComboBox Width="210" ItemsSource="{Binding InvestigationStatuses}" SelectedItem="{Binding InvestigationStatus}" Style="{StaticResource Input.Select}" Margin="8,0,0,0"/>
                <TextBox Width="130" ToolTip="Assigned user ID" Text="{Binding AssignedToText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" Margin="8,0,0,0"/>
                <TextBox Width="180" ToolTip="Correction transaction ID" Text="{Binding CorrectionTransactionIdText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" Margin="8,0,0,0"/>
                <Button Content="Save Investigation" Command="{Binding UpdateExceptionCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBox Text="{Binding InvestigationNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card.Flush}" Margin="0,8,0,0">
            <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}"><TextBlock Text="Investigation timeline" Style="{StaticResource Text.FieldLabel}"/></Border>
            <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding ExceptionDetail.Timeline}" MinHeight="120">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding CreatedAtUtc}"/>
                    <DataGridTextColumn Header="Actor" Binding="{Binding ActorId}"/>
                    <DataGridTextColumn Header="From" Binding="{Binding OldStatus}"/>
                    <DataGridTextColumn Header="To" Binding="{Binding NewStatus}"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
            </Border>
            <TextBlock Text="Resolution is recorded only after the source is corrected and reconciliation is rerun." TextWrapping="Wrap" Style="{StaticResource Text.BodyMuted}" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
