<UserControl x:Class="bams.desktop.Views.Pages.Accounting.TaskDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="Reconciliation task detail" Style="{StaticResource Text.Heading}"/><WrapPanel><Button Content="Back" Command="{Binding BackCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Perform reconcile" Command="{Binding PerformCommand}"/></WrapPanel><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/><TextBlock Text="Why flagged" FontSize="20" Margin="0,16,0,4"/><TextBlock Text="{Binding Detail.FlagExplanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail.Exception.Id ,StringFormat={}Id: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Type ,StringFormat={}Type: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Source ,StringFormat={}Source: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.BusinessDate ,StringFormat={}BusinessDate: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Severity ,StringFormat={}Severity: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Status ,StringFormat={}Status: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.AssignedTo ,StringFormat={}AssignedTo: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.AccountId ,StringFormat={}AccountId: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.PositionSessionId ,StringFormat={}PositionSessionId: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.RelatedTransactionId ,StringFormat={}RelatedTransactionId: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.ExpectedAmount ,StringFormat={}ExpectedAmount: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.ActualAmount ,StringFormat={}ActualAmount: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Difference ,StringFormat={}Difference: {0}}" Margin="0,4"/><TextBlock Text="{Binding Detail.Exception.Notes ,StringFormat={}Notes: {0}}" Margin="0,4"/><TextBlock Text="Status timeline" FontSize="20" Margin="0,16,0,4"/><DataGrid ItemsSource="{Binding Detail.Timeline}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MaxHeight="360"/><TextBlock Text="Current session transactions" FontSize="20" Margin="0,16,0,4"/><DataGrid ItemsSource="{Binding Detail.Transactions}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MaxHeight="360"/><TextBlock Text="Current cash movements" FontSize="20" Margin="0,16,0,4"/><DataGrid ItemsSource="{Binding Detail.Movements}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MaxHeight="360"/><TextBlock Text="Cash count history" FontSize="20" Margin="0,16,0,4"/><DataGrid ItemsSource="{Binding Detail.Counts}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MaxHeight="360"/></StackPanel></ScrollViewer></UserControl>