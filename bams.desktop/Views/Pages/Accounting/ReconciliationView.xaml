<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:bams.desktop.Themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="Account Reconciliation" Style="{StaticResource Text.Title}" />
        <Border Style="{StaticResource Card.Compact}" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="FROM" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource Input.Date}"/>
                    <TextBlock Text="{Binding FromDateError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="TO" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource Input.Date}"/>
                    <TextBlock Text="{Binding ToDateError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="ACCOUNT ID (OPTIONAL)" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox Text="{Binding AccountIdText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
                    <TextBlock Text="{Binding AccountIdError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Run Reconciliation" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}"
                        VerticalAlignment="Top" Margin="0,20,0,0" />
            </Grid>
        </Border>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TabControl MinHeight="430">
            <TabItem Header="Account Results">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Results compare the operational account balance with the balance derived from ledger entries for each business date in the selected range."
                                   Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card.Flush}">
                        <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}"><TextBlock Text="Account balance results" Style="{StaticResource Text.FieldLabel}" /></Border>
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Results}" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountNo}" />
                                <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" />
                                <DataGridTextColumn Header="Operational" Binding="{Binding OperationalBalance, StringFormat=N2}" />
                                <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerBalance, StringFormat=N2}" />
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=N2}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Exceptions and Investigation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Reconciliation exceptions" Style="{StaticResource Text.Subheading}" />
                        <TextBlock Text="Exceptions use the date range selected above. Select an item to review or update its investigation; resolution requires a corrective posting and a matched reconciliation."
                                   Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <ComboBox Width="200" ItemsSource="{Binding ExceptionFilterStatuses}" SelectedItem="{Binding ExceptionFilterStatus}" Style="{StaticResource Input.Select}"/>
                                <Button Content="Refresh" Command="{Binding RefreshExceptionsCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Card.Flush}">
                        <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}"><TextBlock Text="Reconciliation exceptions" Style="{StaticResource Text.FieldLabel}" /></Border>
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Exceptions}" SelectedItem="{Binding SelectedException}" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" />
                                <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedAmount, StringFormat=N2}" />
                                <DataGridTextColumn Header="Actual" Binding="{Binding ActualAmount, StringFormat=N2}" />
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=N2}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card.Compact}" Margin="0,12,0,0" DataContext="{Binding SelectedException}">
                            <StackPanel>
                                <TextBlock Text="Exception investigation" Style="{StaticResource Text.Subheading}" />
                                <WrapPanel Margin="0,8,0,8">
                                    <TextBlock Text="Expected / Actual / Difference: " />
                                    <TextBlock Text="{Binding ExpectedAmount, StringFormat=N2}" Margin="0,0,8,0" />
                                    <TextBlock Text="/ " />
                                    <TextBlock Text="{Binding ActualAmount, StringFormat=N2}" Margin="0,0,8,0" />
                                    <TextBlock Text="/ " />
                                    <TextBlock Text="{Binding Difference, StringFormat=N2}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ASSIGNED USER ID" Style="{StaticResource Text.FieldLabel}"/>
                                        <TextBox Width="150" Text="{Binding DataContext.AssignedToText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
                                        <TextBlock Text="{Binding DataContext.AssignedToError, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="200"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="CORRECTION TRANSACTION ID" Style="{StaticResource Text.FieldLabel}"/>
                                        <TextBox Width="200" Text="{Binding DataContext.CorrectionTransactionIdText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}"/>
                                        <TextBlock Text="{Binding DataContext.CorrectionTransactionIdError, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="240"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBox Text="{Binding DataContext.InvestigationNotes, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Text}" AcceptsReturn="True" MinHeight="64" />
                                <TextBlock Text="{Binding DataContext.InvestigationNotesError, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ComboBox Width="210" ItemsSource="{Binding DataContext.InvestigationStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.InvestigationStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Input.Select}" />
                                    <Button Content="Save Investigation" Command="{Binding DataContext.UpdateExceptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DataContext.InvestigationStatusError, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button Content="Load selected exception audit timeline" Command="{Binding LoadExceptionTimelineCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card.Flush}" Margin="0,8,0,0">
                        <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card.Caption}"><TextBlock Text="Investigation timeline" Style="{StaticResource Text.FieldLabel}" /></Border>
                        <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding ExceptionDetail.Timeline}" MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc}" />
                                <DataGridTextColumn Header="Actor" Binding="{Binding ActorId}" />
                                <DataGridTextColumn Header="From" Binding="{Binding OldStatus}" />
                                <DataGridTextColumn Header="To" Binding="{Binding NewStatus}" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Note}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </StackPanel>
    </ScrollViewer>
</UserControl>
