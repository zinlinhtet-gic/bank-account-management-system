<UserControl x:Class="bams.desktop.Views.Pages.Accounting.SessionCreationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:bams.desktop.Views.Pages.Accounting"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Session Creation" Style="{StaticResource Text.Title}"/><TextBlock Text="{Binding DateLabel}" Style="{StaticResource Text.BodyMuted}" Margin="0,8,0,20"/>
<local:SessionScheduleEditorView DataContext="{Binding Editor}"/><TextBlock Text="{Binding Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,12"/>
<WrapPanel><Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="Create Sessions" Command="{Binding SubmitCommand}" Style="{StaticResource Button.Primary}"/></WrapPanel></StackPanel></ScrollViewer></UserControl>