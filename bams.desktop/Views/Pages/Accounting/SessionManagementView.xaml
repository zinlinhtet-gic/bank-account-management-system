<UserControl x:Class="bams.desktop.Views.Pages.Accounting.SessionManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:bams.desktop.Views.Pages.Accounting"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Create Sessions" Command="{Binding CreateCommand}" Style="{StaticResource Button.Primary}" Visibility="{Binding IsManager,Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="Session Management" Style="{StaticResource Text.Title}"/></DockPanel>
<WrapPanel Margin="0,0,0,16"><DatePicker SelectedDate="{Binding SelectedDate}" Style="{StaticResource Input.Date}" Width="180" Margin="0,0,8,0"/><Button Content="Load Sessions" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel>
<TextBlock Text="{Binding Message}" Style="{StaticResource Text.Error}" TextWrapping="Wrap"/>
<DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Sessions}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="220" PreviewMouseLeftButtonUp="OpenSessionRow"><DataGrid.Columns>
<DataGridTextColumn Header="Session" Binding="{Binding Id}"/><DataGridTextColumn Header="Position" Binding="{Binding PositionType}"/><DataGridTextColumn Header="Officer" Binding="{Binding OfficerName}" Width="*"/>
<DataGridTextColumn Header="Start" Binding="{Binding ScheduledStartAtMyanmar,StringFormat=HH:mm}"/><DataGridTextColumn Header="End" Binding="{Binding ScheduledEndAtMyanmar,StringFormat=HH:mm}"/><DataGridTextColumn Header="Scheduled cash" Binding="{Binding ScheduledStartingCash,StringFormat=N2}"/><DataGridTextColumn Header="Opening cash" Binding="{Binding OpeningCash,StringFormat=N2}"/><DataGridTextColumn Header="Expected cash" Binding="{Binding ExpectedClosingCash,StringFormat=N2}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
<DataGridTemplateColumn Header="Actions"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#x2713;" ToolTip="Accept Session" AutomationProperties.Name="Accept Session" Command="{Binding DataContext.AcceptCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Scheduled"/><Condition Binding="{Binding DataContext.IsOfficer,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="&#x002B;" ToolTip="Request Cash" AutomationProperties.Name="Request Cash" Command="{Binding DataContext.RequestCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Open"/><Condition Binding="{Binding DataContext.IsOfficer,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="&#x25A0;" ToolTip="Close Session" AutomationProperties.Name="Close Session" Command="{Binding DataContext.CloseCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Open"/><Condition Binding="{Binding DataContext.IsOfficer,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="?" ToolTip="Cancel Schedule" AutomationProperties.Name="Cancel Schedule" Command="{Binding DataContext.CancelCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Scheduled"/><Condition Binding="{Binding DataContext.IsManager,RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></UserControl>