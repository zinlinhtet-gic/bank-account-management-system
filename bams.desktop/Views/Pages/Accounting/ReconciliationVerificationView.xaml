<UserControl x:Class="bams.desktop.Views.Pages.Accounting.ReconciliationVerificationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:t="clr-namespace:bams.desktop.Themes" t:RefreshAssist.Command="{Binding PollCommand}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="24">
   <TextBlock Text="Reconciliation verification" Style="{StaticResource Text.Heading}"/>
   <TextBlock Text="Posted corrections awaiting verification. Retry runs the checks again without posting another transaction."
              Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}"
           HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <Border Style="{StaticResource Tab.Strip}" Margin="0,0,0,10">
    <WrapPanel>
     <RadioButton Content="Account and GL" Style="{StaticResource Tab}" GroupName="VerificationTabs"
                  IsChecked="{Binding IsAccountTabSelected,Mode=TwoWay}"/>
     <RadioButton Content="Cash" Style="{StaticResource Tab}" GroupName="VerificationTabs"
                  IsChecked="{Binding IsCashTabSelected,Mode=TwoWay}"/>
    </WrapPanel>
   </Border>
   <Border Style="{StaticResource Card.Flush}" Margin="0,8,0,12">
    <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" MinHeight="220" MaxHeight="600">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Proposal" Binding="{Binding ProposalId}" Width="70"/>
      <DataGridTextColumn Header="Exception" Binding="{Binding ExceptionId}" Width="75"/>
      <DataGridTextColumn Header="Discrepancy" Binding="{Binding Discrepancy}" Width="*"/>
      <DataGridTextColumn Header="Source date" Binding="{Binding SourceBusinessDate,StringFormat=yyyy-MM-dd}" Width="105"/>
      <DataGridTextColumn Header="Posting date" Binding="{Binding PostingDate,StringFormat=yyyy-MM-dd}" Width="105"/>
      <DataGridTextColumn Header="Transaction" Binding="{Binding ExecutionTransactionId}" Width="90"/>
      <DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="100"/>
      <DataGridTextColumn Header="Last result" Binding="{Binding VerificationNote}" Width="2*"/>
      <DataGridTemplateColumn Header="Action" Width="75">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                 ToolTip="Retry verification" AutomationProperties.Name="Retry verification"
                 Command="{Binding DataContext.VerifyCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Margin="3"/>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
   <TextBlock Text="{Binding VerificationMessage}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="Running checks..." Style="{StaticResource Text.BodyMuted}"
              Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
