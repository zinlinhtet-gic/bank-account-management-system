<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:users="clr-namespace:bams.desktop.ViewModels.Pages.Users"
                    xmlns:userviews="clr-namespace:bams.desktop.Views.Pages.Users"
                    xmlns:customers="clr-namespace:bams.desktop.ViewModels.Pages.Customers"
                    xmlns:pages="clr-namespace:bams.desktop.Views.Pages"
                    xmlns:transactions="clr-namespace:bams.desktop.ViewModels.Pages.Transactions"
                    xmlns:transactionviews="clr-namespace:bams.desktop.Views.Pages.Transactions"
                    xmlns:operations="clr-namespace:bams.desktop.ViewModels.Pages.Operations"
                    xmlns:operationviews="clr-namespace:bams.desktop.Views.Pages.Operations"
                    xmlns:accounting="clr-namespace:bams.desktop.ViewModels.Pages.Accounting"
                    xmlns:accountingviews="clr-namespace:bams.desktop.Views.Pages.Accounting">

    <BooleanToVisibilityConverter x:Key="DialogBooleanToVisibilityConverter"/>

    <!--
        Dialog ViewModel → dialog View, used by IDialogService.ShowDialog (Components/ModalDialog).
        Loaded once by App.xaml. Add one DataTemplate per dialog ViewModel, grouped by feature.
    -->

    <DataTemplate DataType="{x:Type accounting:ReconciliationReviewDialog}">
      <ScrollViewer MaxHeight="780" VerticalScrollBarVisibility="Auto"><StackPanel Width="900" Margin="24">
       <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,10"/>
       <TextBlock Text="Investigation findings" Style="{StaticResource Text.FieldLabel}"/><TextBlock Text="{Binding Findings}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
       <TextBlock Text="Evidence reference" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,0"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,10"/>
<TextBlock Text="Original journal" Style="{StaticResource Text.Subheading}" Margin="0,12,0,6"/><Border Style="{StaticResource Card.Flush}"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding OriginalJournal}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="Proposed posting" Style="{StaticResource Text.Subheading}" Margin="0,12,0,6"/><Border Style="{StaticResource Card.Flush}"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding ProposedJournal}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/><DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="Customer balances" Style="{StaticResource Text.Subheading}" Margin="0,12,0,6"/><Border Style="{StaticResource Card.Flush}"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding AccountBalances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="Cash positions (both ends)" Style="{StaticResource Text.Subheading}" Margin="0,12,0,6"/><Border Style="{StaticResource Card.Flush}"><DataGrid Style="{StaticResource Table}" ItemsSource="{Binding CashPositions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="*"/><DataGridTextColumn Header="Expected before" Binding="{Binding BeforeExpected}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding CashChange}" Width="*"/><DataGridTextColumn Header="Expected after" Binding="{Binding AfterExpected}" Width="*"/><DataGridTextColumn Header="Physical before" Binding="{Binding BeforeCounted}" Width="*"/><DataGridTextColumn Header="Physical after" Binding="{Binding AfterCounted}" Width="*"/></DataGrid.Columns></DataGrid></Border><TextBlock Text="Manager decision notes (at least 5 characters)" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,6"/>
       <TextBox Style="{StaticResource Input.Text}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="2000"/>
       <WrapPanel Margin="0,16"><Button Content="Accept proposal" Command="{Binding AcceptCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/><Button Content="Reject proposal" Command="{Binding RejectCommand}" Style="{StaticResource Button.Danger}" Margin="0,0,8,0"/><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Secondary}"/></WrapPanel>
      </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type accounting:ReconciliationActionDialog}">
        <StackPanel Width="460" Margin="24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" Margin="0,0,0,16"/>
            <ComboBox Style="{StaticResource Input.Select}" ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="FullName"
                      Visibility="{Binding IsAssignment,Converter={StaticResource DialogBooleanToVisibilityConverter}}"/>
            <TextBlock Text="Reason / review notes (at least 5 characters)" Margin="0,12,0,6"/>
            <TextBox Style="{StaticResource Input.Text}" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="2000"/>
            <WrapPanel Margin="0,16,0,0"><Button Content="Confirm" Command="{Binding ConfirmCommand}" Style="{StaticResource Button.Primary}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0"/></WrapPanel>
        </StackPanel>
    </DataTemplate>
    <!-- User Management -->
    <DataTemplate DataType="{x:Type users:UserFormViewModel}">
        <userviews:UserFormDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type users:UserDetailsViewModel}">
        <userviews:UserDetailsDialogView/>
    </DataTemplate>

    <!-- Customer Management -->
    <DataTemplate DataType="{x:Type customers:CustomerDetailsViewModel}">
        <pages:CustomerDetailsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type customers:CustomerKycReviewViewModel}">
        <pages:CustomerKycReviewDialogView/>
    </DataTemplate>
    <!-- Transactions -->
    <DataTemplate DataType="{x:Type transactions:TransactionDetailsViewModel}">
        <transactionviews:TransactionDetailsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type transactions:NrcPickupFormViewModel}">
        <transactionviews:NrcPickupDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type transactions:NrcPickupCodeViewModel}">
        <transactionviews:NrcPickupCodeDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type transactions:PendingTransferActionViewModel}">
        <transactionviews:PendingTransferActionDialogView/>
    </DataTemplate>

    <!-- Accounting -->
    <DataTemplate DataType="{x:Type accounting:CashRequestDialogViewModel}">
        <accountingviews:CashRequestDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type transactions:AccountStatementViewModel}">
        <transactionviews:AccountStatementDialogView/>
    </DataTemplate>

    <!-- Operations -->
    <DataTemplate DataType="{x:Type operations:InterestOperationDetailsViewModel}">
        <operationviews:InterestOperationDetailsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type operations:FeeOperationDetailsViewModel}">
        <operationviews:FeeOperationDetailsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type operations:FixedDepositMaturityDetailsViewModel}">
        <operationviews:FixedDepositMaturityDetailsDialogView/>
    </DataTemplate>
</ResourceDictionary>
