<UserControl x:Class="bams.desktop.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600">
    <Grid Background="#F5F5F5">
        <Border Background="White"
                CornerRadius="8"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Effect="{DynamicResource DropShadow}">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Text="Change Password"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           Foreground="#2C3E50"/>

                <TextBlock Text="{Binding PasswordRequirements}"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="#7F8C8D"
                           Margin="0,0,0,24"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Current Password"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="#34495E"/>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Padding="8,8,40,8"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"
                                 PasswordChanged="OnCurrentPasswordChanged"/>

                    <TextBox x:Name="CurrentPasswordTextBox"
                             Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,8,40,8"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             Visibility="Collapsed"/>

                    <Button Click="OnToggleCurrentPasswordClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40"
                            ToolTip="Toggle password visibility">
                        <TextBlock x:Name="CurrentEyeIcon"
                                   Text="👁‍🗨"
                                   FontSize="16"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <TextBlock Text="New Password"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="#34495E"/>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="NewPasswordBox"
                                 Padding="8,8,40,8"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"
                                 PasswordChanged="OnNewPasswordChanged"/>

                    <TextBox x:Name="NewPasswordTextBox"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,8,40,8"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             Visibility="Collapsed"/>

                    <Button Click="OnToggleNewPasswordClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40"
                            ToolTip="Toggle password visibility">
                        <TextBlock x:Name="NewEyeIcon"
                                   Text="👁‍🗨"
                                   FontSize="16"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <TextBlock Text="Confirm New Password"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="#34495E"/>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Padding="8,8,40,8"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"
                                 PasswordChanged="OnConfirmPasswordChanged"/>

                    <TextBox x:Name="ConfirmPasswordTextBox"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,8,40,8"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             Visibility="Collapsed"/>

                    <Button Click="OnToggleConfirmPasswordClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40"
                            ToolTip="Toggle password visibility">
                        <TextBlock x:Name="ConfirmEyeIcon"
                                   Text="👁‍🗨"
                                   FontSize="16"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <Button Content="Change Password"
                        Command="{Binding ChangePasswordCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        Padding="12"
                        Margin="0,8,0,0"
                        FontWeight="SemiBold"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E74C3C"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#27AE60"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>