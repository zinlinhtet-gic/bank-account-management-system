<UserControl x:Class="bams.desktop.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:vm="clr-namespace:bams.desktop.ViewModels"
             xmlns:icon="clr-namespace:bams.desktop.Components.Icon"
             xmlns:brand="clr-namespace:bams.desktop.Components.AuthBrandPanel"
             xmlns:pwd="clr-namespace:bams.desktop.Components.PasswordInput"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <!-- One line of the live password checklist. Tag = true when the rule is met. -->
        <Style x:Key="PasswordRule" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Pending" Width="10" Height="10" StrokeThickness="1.5"
                                         Stroke="{StaticResource BorderBrush}"/>
                                <Border x:Name="Done" CornerRadius="8" Background="{StaticResource SuccessBrush}" Visibility="Collapsed">
                                    <icon:Icon Geometry="{StaticResource Icon.Check}" Size="10" StrokeThickness="3"
                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource FontSizeCaption}"
                                              TextElement.Foreground="{StaticResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Pending" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Same split layout as the login screen. -->
    <Grid Background="{StaticResource CardBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <brand:AuthBrandPanel/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="400" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center"
                        FocusManager.FocusedElement="{Binding ElementName=CurrentPasswordInput}">

                <TextBlock Text="SECURITY CHECK" Style="{StaticResource Text.Label}" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Set a new password" Style="{StaticResource Text.Heading}" FontSize="28" Margin="0,8,0,8"/>
                <TextBlock Style="{StaticResource Text.BodyMuted}" Margin="0,0,0,24">
                    <Run Text="Signed in as"/>
                    <Run Text="{Binding UserDisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}"/><Run Text=". Choose a new password before continuing."/>
                </TextBlock>

                <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,0,0,20"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource Text.FieldLabel}"/>
                <pwd:PasswordInput x:Name="CurrentPasswordInput" Password="{Binding CurrentPassword}"
                                   IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,18"/>

                <TextBlock Text="NEW PASSWORD" Style="{StaticResource Text.FieldLabel}"/>
                <pwd:PasswordInput Password="{Binding NewPassword}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,18"/>

                <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Text.FieldLabel}"/>
                <pwd:PasswordInput Password="{Binding ConfirmPassword}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,18"/>

                <!-- Live checklist: each rule turns green as soon as it is satisfied. -->
                <Border Background="{StaticResource MutedBrush}" CornerRadius="{StaticResource Radius}" Padding="16,14,16,6" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="YOUR PASSWORD MUST HAVE" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding MeetsMinimumLength}"
                                            Content="{Binding Source={x:Static vm:ChangePasswordViewModel.MinimumPasswordLength}}"
                                            ContentStringFormat="At least {0} characters"/>
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding HasUppercase}" Content="An uppercase letter (A-Z)"/>
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding HasLowercase}" Content="A lowercase letter (a-z)"/>
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding HasDigit}" Content="A number (0-9)"/>
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding HasSpecialCharacter}" Content="A symbol (! @ # $ % ...)"/>
                            <ContentControl Style="{StaticResource PasswordRule}" Tag="{Binding PasswordsMatch}" Content="Both new passwords match"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Button Content="Update password" Style="{StaticResource Button.Primary}" t:ThemeAssist.Size="Large"
                        HorizontalAlignment="Stretch" IsDefault="True"
                        t:ThemeAssist.IsLoading="{Binding IsBusy}"
                        Command="{Binding ChangePasswordCommand}"/>

                <ContentControl Style="{StaticResource Alert.Success}" Content="{Binding StatusMessage}" Margin="0,20,0,0"
                                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
