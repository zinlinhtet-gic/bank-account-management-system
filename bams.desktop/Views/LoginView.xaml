<UserControl x:Class="bams.desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600">
    <Grid Background="#F5F5F5">
        <Border Background="White"
                CornerRadius="8"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Effect="{DynamicResource DropShadow}">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Text="BAMS Login"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           Foreground="#2C3E50"/>

                <TextBlock Text="Username"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="#34495E"/>

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         Margin="0,0,0,16"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"/>

                <TextBlock Text="Password"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="#34495E"/>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="PasswordBox"
                                 Padding="8,8,40,8"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"
                                 PasswordChanged="OnPasswordChanged"/>

                    <TextBox x:Name="PasswordTextBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,8,40,8"
                             BorderBrush="#BDC3C7"
                             BorderThickness="1"
                             Visibility="Collapsed"/>

                    <Button Click="OnTogglePasswordClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40"
                            ToolTip="Toggle password visibility">
                        <TextBlock x:Name="EyeIcon"
                                   Text="👁‍🗨"
                                   FontSize="16"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        Padding="12"
                        Margin="0,8,0,0"
                        FontWeight="SemiBold"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E74C3C"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#27AE60"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>