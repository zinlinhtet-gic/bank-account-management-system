<UserControl x:Class="bams.desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:t="clr-namespace:bams.desktop.Themes"
             xmlns:brand="clr-namespace:bams.desktop.Components.AuthBrandPanel"
             xmlns:pwd="clr-namespace:bams.desktop.Components.PasswordInput"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <!-- Split layout: brand panel on the left, sign-in form on the right. -->
    <Grid Background="{StaticResource CardBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <brand:AuthBrandPanel/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="380" Margin="0,48" VerticalAlignment="Center" HorizontalAlignment="Center"
                        FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">

                <TextBlock Text="STAFF SIGN IN" Style="{StaticResource Text.Label}" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Welcome back" Style="{StaticResource Text.Heading}" FontSize="28" Margin="0,8,0,8"/>
                <TextBlock Text="Sign in with the username and password provided by your branch manager."
                           Style="{StaticResource Text.BodyMuted}" Margin="0,0,0,28"/>

                <ContentControl Style="{StaticResource Alert.Danger}" Content="{Binding ErrorMessage}" Margin="0,0,0,20"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="USERNAME" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource Input.Text}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         t:ThemeAssist.Placeholder="e.g. officer"
                         IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,18"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource Text.FieldLabel}"/>
                <pwd:PasswordInput Password="{Binding Password}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,28"/>

                <!-- IsDefault: pressing Enter anywhere in the form signs in. -->
                <Button Content="Sign in" Style="{StaticResource Button.Primary}" t:ThemeAssist.Size="Large"
                        HorizontalAlignment="Stretch" IsDefault="True"
                        t:ThemeAssist.IsLoading="{Binding IsBusy}"
                        Command="{Binding LoginCommand}"/>

                <ContentControl Style="{StaticResource Alert.Info}" Content="{Binding StatusMessage}" Margin="0,20,0,0"
                                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,32,0,16"/>
                <TextBlock Text="Trouble signing in? Contact your branch manager to reset your password."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
